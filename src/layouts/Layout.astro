---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  lang?: 'am' | 'en';
  image?: string;
  type?: 'website' | 'article';
  datePublished?: string;
  dateModified?: string;
  content?: string;
  tags?: string[];
  category?: string;
}

const { lang = 'am' } = Astro.props;
const {
  title,
  description = lang === 'en'
    ? 'Open-source knowledge base about Ethiopia'
    : 'ክፍት የዕውቀት ምንጭ ስለ ኢትዮጵያ',
  image,
  type,
  datePublished,
  dateModified,
  content,
  tags,
  category,
  noindex,
} = Astro.props;

// Search index now loaded via /api/search-index.json (fetch API)
const isEn = lang === 'en';
const categorySlug = category?.toLowerCase() || '';
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = currentPath === '/' || currentPath === '/en';
const bodyClass = [
  isHome ? 'page-home' : 'page-default',
  categorySlug ? `category-${categorySlug}` : '',
]
  .filter(Boolean)
  .join(' ');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Ethiopia Typography System: Google Fonts Noto Sans/Serif Ethiopic + Noto Sans -->
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+Ethiopic:wght@300;400;500;600;700;800;900&family=Noto+Serif+Ethiopic:wght@400;600;700;900&family=Noto+Sans:ital,wght@0,400;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <title>{title} | Ethiopia.md</title>
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Ethiopia.md RSS"
      href="/rss.xml"
    />
    <SEO
      title={title}
      description={description}
      lang={lang}
      image={image}
      type={type}
      datePublished={datePublished}
      dateModified={dateModified}
      content={content}
      tags={tags}
      category={category}
    />
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-JGC5W00N7T"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-JGC5W00N7T');
    </script>
  </head>
  <body class={bodyClass}>
    <Header />

    <script is:inline>
      // ── CJK bigram query tokenizer ──
      // Amharic (Ge'ez script, U+1200-U+137F) is not CJK, so the CJK bigram
      // splitter below never runs on Amharic queries -- _isCJK() only matches
      // Han-script code points. Left empty rather than inventing Amharic
      // "stop bigram" data that would be fabricated and functionally unused.
      var _STOP_BIGRAMS = new Set([]);

      function _isCJK(ch) {
        var cp = ch.codePointAt(0);
        return (cp >= 0x4e00 && cp <= 0x9fff) || (cp >= 0x3400 && cp <= 0x4dbf);
      }

      function _queryBigrams(text) {
        var normalized = text.toLowerCase().normalize('NFKC').trim();
        var segments = normalized.split(/\s+/).filter(Boolean);
        var allTokens = [];
        var filtered = [];
        for (var s = 0; s < segments.length; s++) {
          var seg = segments[s];
          var chars = Array.from(seg);
          var hasCJK = chars.some(function (ch) {
            return _isCJK(ch);
          });
          if (!hasCJK) {
            allTokens.push(seg);
            filtered.push(seg);
            continue;
          }
          if (chars.length === 1) {
            allTokens.push(chars[0]);
            filtered.push(chars[0]);
          } else {
            for (var i = 0; i < chars.length - 1; i++) {
              var bigram = chars[i] + chars[i + 1];
              allTokens.push(bigram);
              if (!_STOP_BIGRAMS.has(bigram)) filtered.push(bigram);
            }
          }
        }
        return filtered.length > 0 ? filtered : allTokens;
      }

      // ── Search engine (MiniSearch with fallback) ──
      var _searchEngine = null;
      var _searchMode = 'loading';
      var _fallbackIdx = null;

      async function _initSearchEngine() {
        try {
          var res = await fetch('/api/search-minisearch.json');
          if (!res.ok) throw new Error('HTTP ' + res.status);
          var data = await res.json();
          var MiniSearch = (
            await import('https://cdn.jsdelivr.net/npm/minisearch@7/dist/es/index.min.js')
          ).default;
          _searchEngine = MiniSearch.loadJSON(JSON.stringify(data), {
            idField: 'id',
            fields: ['title_bigram', 'desc_bigram', 'tags_bigram'],
            storeFields: ['t', 'd', 'u', 'tags', 'lang'],
            tokenize: function (text) {
              return text.split(/\s+/).filter(Boolean);
            },
            searchOptions: {
              boost: { title_bigram: 6, tags_bigram: 4, desc_bigram: 2 },
              prefix: true,
            },
          });
          _searchMode = 'minisearch';
        } catch (e) {
          console.warn(
            '[search] MiniSearch failed, falling back to indexOf:',
            e,
          );
          try {
            var res2 = await fetch('/api/search-index.json');
            if (res2.ok) _fallbackIdx = await res2.json();
            else _fallbackIdx = [];
          } catch (e2) {
            _fallbackIdx = [];
          }
          _searchMode = 'fallback';
        }
      }

      function _doSearch(q, lang) {
        if (_searchMode === 'minisearch' && _searchEngine) {
          var bigrams = _queryBigrams(q);
          var raw = _searchEngine.search(bigrams.join(' '), {
            prefix: true,
            limit: 200,
          });
          var topScore = raw.length > 0 ? raw[0].score : 0;
          var cutoff = topScore * 0.02;
          var matches = raw
            .filter(function (r) {
              return r.score >= cutoff;
            })
            .slice(0, 30);
          // Sort: current language first
          matches.sort(function (a, b) {
            var aLang = a.lang === lang ? 0 : 1;
            var bLang = b.lang === lang ? 0 : 1;
            return aLang - bLang;
          });
          return matches;
        }
        // Fallback: indexOf
        var idx = _fallbackIdx || [];
        var lq = q.toLowerCase();
        var matches = idx.filter(function (item) {
          return (
            item.t.toLowerCase().indexOf(lq) !== -1 ||
            item.d.toLowerCase().indexOf(lq) !== -1 ||
            item.tags.some(function (tag) {
              return String(tag).toLowerCase().indexOf(lq) !== -1;
            })
          );
        });
        matches.sort(function (a, b) {
          return (a.lang === lang ? 0 : 1) - (b.lang === lang ? 0 : 1);
        });
        return matches;
      }

      function _renderResult(item) {
        var langBadge = item.lang === 'en' ? 'EN' : 'አማ';
        var title = item.t || '';
        var desc = item.d || '';
        return (
          '<a class="search-item" href="' +
          item.u +
          '">' +
          '<span class="search-item-lang">' +
          langBadge +
          '</span>' +
          '<div class="search-item-text">' +
          '<span class="search-item-title">' +
          title +
          '</span>' +
          (desc ? '<span class="search-item-desc">' + desc + '</span>' : '') +
          '</div></a>'
        );
      }

      function initSearch() {
        var isEn = document.documentElement.lang === 'en';
        var lang = isEn ? 'en' : 'am';
        var input = document.getElementById('search-input');
        if (!input) return;
        var results = document.getElementById('search-results');
        var modal = document.getElementById('search-modal');
        var hintEmpty = isEn
          ? 'Type to search across all articles'
          : 'ሁሉንም ጽሑፎች ለመፈለግ ቃላትን ያስገቡ';
        var hintNone = isEn ? 'No results found' : 'ምንም ውጤት አልተገኘም';

        _initSearchEngine();

        input.addEventListener('input', function () {
          var q = this.value.trim();
          if (!q) {
            results.innerHTML =
              '<div class="search-hint">' + hintEmpty + '</div>';
            return;
          }
          // Single-char queries are handled by prefix match
          if (_searchMode === 'loading') {
            results.innerHTML =
              '<div class="search-hint">' +
              (isEn ? 'Loading...' : 'በመጫን ላይ...') +
              '</div>';
            return;
          }
          var matches = _doSearch(q, lang);
          if (matches.length === 0) {
            results.innerHTML =
              '<div class="search-hint">' + hintNone + '</div>';
            return;
          }
          var html = matches.slice(0, 12).map(_renderResult).join('');
          if (matches.length > 12) {
            html +=
              '<div class="search-hint">' +
              (isEn
                ? '...and ' + (matches.length - 12) + ' more'
                : '...እና ' + (matches.length - 12) + ' ተጨማሪ') +
              '</div>';
          }
          results.innerHTML = html;
        });

        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && modal.classList.contains('open')) {
            modal.classList.remove('open');
          }
          if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
            e.preventDefault();
            modal.classList.toggle('open');
            if (modal.classList.contains('open')) {
              setTimeout(function () {
                input.focus();
              }, 100);
            }
          }
        });
      }

      function _tryInit() {
        if (document.getElementById('search-input')) {
          initSearch();
        } else {
          setTimeout(_tryInit, 50);
        }
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', _tryInit);
      } else {
        _tryInit();
      }
    </script>

    <main role="main">
      <slot />
    </main>

    <Footer />

    <!-- Floating .md button -->
    <a
      id="md-btn"
      class="floating-md"
      title="ጥሬ Markdown ምንጭ ይመልከቱ"
      target="_blank"
    >
      .md
    </a>

    <script is:inline>
      // Set .md button href based on current path
      const btn = document.getElementById('md-btn');
      const pathname = window.location.pathname;
      const ghBase = 'https://github.com/EyuReaper/ethiopia-md/blob/main';

      let target = '/README.md'; // Default fallback

      // Handle special pages
      if (
        pathname === '/' ||
        pathname === '/en' ||
        pathname === '/en/' ||
        pathname === '/index.html'
      ) {
        target = '/README.md';
      } else if (pathname.includes('/contribute')) {
        target = '/CONTRIBUTING.md';
      } else if (pathname.includes('/resources')) {
        target = '/knowledge/About/Ethiopia.md';
      } else if (pathname.includes('/graph')) {
        target = '/src/pages/graph.astro';
      } else if (pathname.includes('/about')) {
        target = '/src/pages/about.astro';
      } else {
        // Content pages (Categories or Articles)
        const isEn = pathname.startsWith('/en/');
        // Remove /en/ prefix and leading/trailing slashes
        const cleanPath = pathname
          .replace(/^\/en/, '')
          .replace(/^\//, '')
          .replace(/\/$/, '')
          .replace('index.html', '');
        const parts = cleanPath.split('/');

        if (parts.length > 0 && parts[0]) {
          const cat = parts[0];
          // Capitalize first letter of category (history -> History)
          const catFolder = cat.charAt(0).toUpperCase() + cat.slice(1);

          // ZH source is in knowledge/Category, EN source is in knowledge/en/Category
          const prefix = isEn ? '/knowledge/en' : '/knowledge';

          if (parts.length === 1) {
            // Category Hub: knowledge/History/_History Hub.md
            target = `${prefix}/${catFolder}/_${catFolder} Hub.md`;
          } else {
            // Article: knowledge/History/article-name.md
            const slug = decodeURIComponent(parts.slice(1).join('/'));
            target = `${prefix}/${catFolder}/${slug}.md`;
          }
        }
      }

      btn.href = ghBase + target;

      // Hash-based active state can only be detected client-side
      if (window.location.hash === '#categories') {
        document
          .querySelectorAll('.nav-link[href$="/#categories"]')
          .forEach((l) => l.classList.add('active'));
      }
    </script>
  </body>
</html>

<style is:global>
  html {
    font-size: 118%;
    overflow-x: hidden;
  }

  html,
  body {
    max-width: 100vw;
    overflow-x: hidden;
  }
  :root {
    --container-wide: 1380px;
    --container-page: 1180px;
    --container-reading: 1080px;
    --space-page-x: clamp(1rem, 2vw, 2rem);
    --space-section-y: clamp(3.5rem, 7vw, 6rem);
    --space-1: 0.5rem;
    --space-2: 0.75rem;
    --space-3: 1rem;
    --space-4: 1.5rem;
    --space-5: 2rem;
    --space-6: 2.5rem;
    --space-7: 3rem;
    --space-8: 4rem;
    --space-9: 5rem;
    --radius-chip: 16px;
    --radius-card: 20px;
    --radius-pill: 999px;
    --shadow-soft: 0 8px 30px rgba(15, 23, 42, 0.06);
    --shadow-card: 0 16px 40px rgba(15, 23, 42, 0.08);
    --border-soft: 1px solid rgba(148, 163, 184, 0.2);
    /* === Ethiopia Typography System === */
    --font-title:
      'Noto Serif Ethiopic', 'Noto Serif', 'Nyala', 'Abyssinica SIL', serif;
    --font-reading:
      'Noto Sans Ethiopic', 'Noto Sans', 'Nyala', system-ui, -apple-system,
      BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --font-interface:
      'Noto Sans Ethiopic', 'Noto Sans', system-ui, -apple-system,
      BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --font-quote:
      'Noto Serif Ethiopic', 'Noto Serif', 'Nyala', 'Kefa', Georgia, serif;
    --font-mono:
      'SF Mono', 'Fira Code', 'Source Code Pro', 'Consolas', monospace;
    /* Legacy compatibility */
    --font-editorial: var(--font-title);
    --title-display-size: clamp(2.25rem, 5vw, 3.2rem);
    --title-section-size: clamp(1.95rem, 4vw, 2.5rem);
    --title-subsection-size: clamp(1.3rem, 2.4vw, 1.7rem);
    --title-minor-size: 1.1rem;
    --title-line-height: 1.2;
    --title-letter-spacing: 0;
    --copy-intro-size: clamp(1rem, 1.6vw, 1.08rem);
    --copy-intro-line: 1.75;
    --copy-intro-color: #64748b;
    --copy-intro-width: 42rem;
  }
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  /* Focus styles for keyboard accessibility */
  *:focus-visible {
    outline: 2px solid #3b82f6;
    outline-offset: 2px;
  }

  button:focus-visible,
  a:focus-visible,
  input:focus-visible {
    outline: 2px solid #3b82f6;
    outline-offset: 2px;
  }

  /* ===== Ethiopia Webfont ===== */
  body {
    /* ነባሪ፦ ለረጅም ንባብ የተስማማ የኢትዮጵያ ይዘት */
    font-family: var(--font-reading);
    font-weight: 400;
    line-height: 1.75;
    color: #1a1a2e;
    background:
      radial-gradient(
        circle at top,
        rgba(226, 232, 240, 0.35),
        transparent 30%
      ),
      linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
    /* የፊደል ገፅታዎች፦ ክፍተት ማስተካከያ እና ማገናኘት */
    font-feature-settings:
      'kern' 1,
      'liga' 1;
    width: 100%;
    max-width: 100vw;
  }

  /* Ethiopia Typography: ርዕሶች */
  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family: var(--font-title);
    letter-spacing: -0.02em;
    line-height: 1.3;
  }
  h1 {
    font-weight: 900;
    letter-spacing: -0.03em;
  }
  h2 {
    font-weight: 800;
  }
  h3,
  h4 {
    font-weight: 700;
  }
  h5,
  h6 {
    font-weight: 600;
  }

  /* Blockquote — ጥቅስ (አጽንዖት ያለው አንቀጽ) */
  main blockquote {
    font-family: var(--font-quote);
    font-weight: 400;
    font-style: normal;
    letter-spacing: 0.01em;
    line-height: 1.8;
  }

  /* Interface — ፊደል */
  nav,
  button,
  .btn-primary,
  .btn-secondary,
  .btn-cta,
  [class*='btn'],
  .meta-item,
  .tag,
  .category-badge,
  .search-input {
    font-family: var(--font-interface);
    font-weight: 600;
  }

  /* Main - full width */
  main {
    min-height: calc(100vh - 60px);
    width: 100%;
    max-width: 100vw;
    overflow-x: hidden;
  }
  body.page-default main {
    padding-top: 56px;
  }
  body.page-default main.article-page,
  body.page-default main.graph-page,
  body.page-default main.dashboard,
  body.page-default main.term-page,
  body.page-default main.fork-graph-page {
    padding-top: 0;
  }
  main img {
    max-width: 100%;
    max-height: 400px;
    object-fit: cover;
    border-radius: 12px;
  }

  /* Global link styles */
  main
    a:not(.nav-link):not([class*='btn']):not(.card-link):not(.logo):not(
      .category-card
    ):not(.floating-md):not(.search-item):not(.reading-step):not(.update-item) {
    color: #475569;
    text-decoration: none;
    border-bottom: 1px solid #cbd5e1;
    padding-bottom: 1px;
    transition: all 0.2s ease;
  }
  main
    a:not(.nav-link):not([class*='btn']):not(.card-link):not(.logo):not(
      .category-card
    ):not(.floating-md):not(.search-item):not(.reading-step):not(
      .update-item
    ):hover {
    color: #1a1a2e;
    border-bottom-color: #64748b;
  }
  /* External links (with target="_blank") get an icon */
  main
    a[target='_blank']:not(.nav-link):not([class*='btn']):not(.card-link):not(
      .logo
    ):not(.category-card):not(.floating-md):not(.contributor-card)::after {
    content: '↗';
    font-size: 0.8em;
    margin-left: 0.2em;
    opacity: 0.7;
  }

  /* Floating .md button */
  .floating-md {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    width: 48px;
    height: 48px;
    background: #1a1a2e;
    color: #3b82f6;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'SF Mono', 'Fira Code', monospace;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    box-shadow: var(--shadow-card);
    transition: all 0.2s;
    z-index: 40;
  }
  .floating-md:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(59, 130, 246, 0.3);
    background: #3b82f6;
    color: white;
  }

  @media (max-width: 768px) {
    html {
      font-size: 100%;
    }
    body.page-default main {
      padding-top: 52px;
    }
    body.page-default main.article-page,
    body.page-default main.graph-page,
    body.page-default main.dashboard,
    body.page-default main.term-page,
    body.page-default main.fork-graph-page {
      padding-top: 0;
    }
    .floating-md {
      bottom: 1rem;
      right: 1rem;
      width: 42px;
      height: 42px;
      font-size: 0.78rem;
    }
  }
</style>
