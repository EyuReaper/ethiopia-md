---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/home/HeroSection.astro';
import CoverStory from '../components/home/CoverStory.astro';
import RandomDiscovery from '../components/home/RandomDiscovery.astro';
import ReadingPath from '../components/ReadingPath.astro';
import FeatureCards from '../components/FeatureCards.astro';
import CategoriesSection from '../components/home/CategoriesSection.astro';
import LanguageStatement from '../components/home/LanguageStatement.astro';
import RecentUpdates from '../components/home/RecentUpdates.astro';
import NewsletterSection from '../components/home/NewsletterSection.astro';
import CommunityFeedback from '../components/home/CommunityFeedback.astro';
import ContributeSection from '../components/home/ContributeSection.astro';
import ProticoScript from '../components/ProticoScript.astro';
import { fetchRecentCommits } from '../lib/commits';
import { feedbacks } from '../data/feedbacks';

const recentCommits = await fetchRecentCommits();

const readingPathSteps = [
  {
    href: '/history',
    title: 'ታሪክ፦ የኢትዮጵያ ጥንታዊ ቅርስ',
    description: 'ከጥንታዊ ስልጣኔ እስከ ዘመናዊ ዘመን የተዘረጋ የኢትዮጵያ ታሪካዊ ጉዞ',
    time: '6 min',
  },
  {
    href: '/culture',
    title: 'ባህል፦ የኢትዮጵያ ብሄረሰባዊ ብዝሃነት',
    description: 'የተለያዩ ብሄረሰቦችና ወጎች የተዋሃዱበት ሀብታም ባህላዊ መልክዓ ምድር',
    time: '7 min',
  },
  {
    href: '/food',
    title: 'ምግብ፦ የኢትዮጵያ የጣዕም ዓለም',
    description: 'ከባህላዊ ወጥና እንጀራ እስከ ዘመናዊ የምግብ ባህል',
    time: '5 min',
  },
  {
    href: '/technology',
    title: 'ቴክኖሎጂ፦ ወደፊት የምትራመድ ኢትዮጵያ',
    description: 'ዲጂታል ፈጠራና የቴክኖሎጂ ዕድገት በኢትዮጵያ',
    time: '8 min',
  },
  {
    href: '/lifestyle',
    title: 'አኗኗር፦ የኢትዮጵያውያን ዕለታዊ ኑሮ',
    description: 'ከከተማ እስከ ገጠር የሚንፀባረቅ የዘመናዊ ኢትዮጵያውያን አኗኗር ዘይቤ',
    time: '4 min',
  },
];

const readingPathFooterItems = [
  { icon: '⏱️', label: 'በግምት 30 ደቂቃ' },
  { icon: '🎯', label: '5 ደረጃዎች' },
  { icon: '🌟', label: 'ኢትዮጵያን ይወቁ' },
];
---

<Layout
  title="ኢትዮጵያን በጥልቀት ይወቁ | Ethiopia.md"
  description="ክፍት ምንጭ የሆነ፣ ለ AI ምቹ የሆነ የኢትዮጵያ ዕውቀት መደብር። በርካታ ጽሑፎች በታሪክ፣ ባህል፣ ምግብ፣ ቴክኖሎጂ እና ሌሎች 12 ዘርፎች ውስጥ፣ በማህበረሰብ የተገነቡ፣ እውነተኛዋን ኢትዮጵያ ለማሳየት ያለሙ።"
>
  <HeroSection />

  <CoverStory />

  <RandomDiscovery />

  <ReadingPath
    title="📖 ከየት እንደሚጀምሩ አያውቁም？"
    subtitle="በእነዚህ 5 አስፈላጊ ጽሑፎች ውስጥ በ30 ደቂቃ ውስጥ እውነተኛዋን ኢትዮጵያ ይወቁ"
    steps={readingPathSteps}
    footerItems={readingPathFooterItems}
    continueHref="#categories"
    continueLabel="ተጨማሪ ርዕሶችን መፈለግዎን ይቀጥሉ →"
  />

  <FeatureCards
    lang="am"
    sectionTitle="ለምን Ethiopia.md？"
    cards={[
      {
        icon: '🎯',
        title: 'የተመረጡ አመለካከቶች',
        description: 'በጥንቃቄ የተመረጡ ጥልቅ ታሪኮች፣ ኢንሳይክሎፔዲያዊ ዝርዝር ብቻ አይደሉም',
      },
      {
        icon: '🤖',
        title: 'ለ AI ምቹ ንድፍ',
        description: 'AI የኢትዮጵያን ውስብስብነት እንዲረዳ የሚያግዝ የተዋቀረ ይዘት',
      },
      {
        icon: '🌍',
        title: 'ባለሁለት ቋንቋ ዓለም አቀፍ ራዕይ',
        description: 'ከአካባቢያዊ እይታዎች በመነሳት የኢትዮጵያን ታሪክ በዓለም አቀፍ ቋንቋዎች መናገር',
      },
      {
        icon: '📚',
        title: 'የተሟላ ባለብዙ-ልኬት',
        description: 'ከ12 በላይ ዘርፎችን በመሸፈን የኢትዮጵያን ባለ ሶስት አቅጣጫዊ የተሟላ ምስል ማቅረብ',
      },
    ]}
  >
    <div class="features-cta">
      <a href="/graph" class="feature-btn">🔗 የዕውቀት ግራፍ — ግንኙነቶችን ያስሱ</a>
      <a
        href="https://github.com/EyuReaper/ethiopia-md/tree/main/knowledge"
        target="_blank"
        rel="noopener noreferrer"
        class="feature-btn secondary">📂 የSSOT ማከማቻ በGitHub ይመልከቱ ↗</a
      >
    </div>
  </FeatureCards>

  <section class="mini-graph-section">
    <a href="/graph" class="mini-graph-link">
      <div class="mini-graph-text">
        <h3>🕸️ የዕውቀት ግራፍ</h3>
        <p>የርዕሶችን ግንኙነት ይመልከቱ — የኢትዮጵያን የዕውቀት መረብ ያስሱ</p>
      </div>
      <div id="mini-graph" class="mini-graph-container"></div>
    </a>
  </section>

  <CategoriesSection>
    <Fragment slot="prose">
      <p>
        ኢትዮጵያ ከፍተኛ ተራሮችን፣ ሰፊ አምባዎችን፣ ጥልቅ ሸለቆዎችንና ሐይቆችን የያዘ በእጅጉ የተለያየ መልክዓ ምድር
        ያላት ሀገር ናት። ይህ የተፈጥሮ ልዩነት የአየር ንብረት፣ የግብርናና የኑሮ ዘይቤዎችን ከክልል ክልል በተለያየ
        መንገድ ቀርጿል፣
        <a href="/geography" class="topic-pill">🗺️ ጂኦግራፊ</a>ን በማሰስ የሀገሪቱን የተፈጥሮ
        ሀብቶች እና እነዚህ በአካባቢው ማህበረሰብ ላይ ያላቸውን ተጽዕኖ የበለጠ መረዳት ይቻላል፣ ከከፍታ ቦታዎች እስከ
        ቆላማ አካባቢዎች፣ እያንዳንዱ ክልል የራሱ ገጽታ አለው።
      </p>

      <p>
        ኢትዮጵያ ረጅም ታሪክ ያላት ሀገር ናት፣ የተለያዩ ዘመናትንና ለውጦችን አልፋለች። ከጥንታዊ ስልጣኔዎች— የመንግስት
        ምስረታ፣ የንግድ መስመሮች፣ የሃይማኖት ስርጭት፣ የቅኝ ግዛት ተጋድሎ—እስከ ዘመናዊው ዘመን ድረስ። ኢትዮጵያ
        የራሷን ፊደልና የዘመን አቆጣጠር የያዘች ሀገር በመሆኗ በአፍሪካ ውስጥ ልዩ ስፍራ አላት፣ ይህንን ጉዞ በጥልቀት
        ለማወቅ<a href="/history" class="topic-pill">📜 ታሪክ</a>ን ይመልከቱ። ያለፈውን
        በመረዳት፣ ዛሬ ያለችውን ኢትዮጵያ በተሻለ መንገድ መረዳት ይቻላል፣ የወደፊቷንም አቅጣጫ በተሻለ ለመገመት ያግዛል።
      </p>

      <p>
        የኢትዮጵያ ባህል ከብዙ ብሄረሰቦችና ቋንቋዎች የተዋሃደ ሀብታም ቅርስ ነው። እያንዳንዱ ማህበረሰብ የራሱ የሆነ
        ወግ፣ አለባበስ፣ በዓላትና እሴቶች ያለው ሲሆን፣ በአንድነትም ሆነ በልዩነት የሚያምር ብሄራዊ ማንነትን ይፈጥራል፣
        ይህ ደግሞ ለጎብኚም ሆነ ለተመራማሪ ሁልጊዜ አዲስ ነገር ያቀርባል።
        <a href="/culture" class="topic-pill">🎭 የኢትዮጵያ ባህል</a>ን በማሰስ፣ እነዚህ ወጎች
        በዘመናት ውስጥ እንዴት— እንደተሻሻሉና ዛሬም ድረስ በዕለት ተዕለት ኑሮ ውስጥ ሕያው ሆነው እንደቀጠሉ ይረዳሉ።
      </p>

      <p>
        የኢትዮጵያ ምግብ ባህል የሀገሪቱን ብዝሃነት የሚያንፀባርቅ ነው፣ ከባህላዊ የቤት ውስጥ ምግቦች፣ ወጎች፣ ወደ
        ከተሞች የተስፋፉ ዘመናዊ የምግብ ቤቶች ድረስ የተለያዩ ጣዕሞችን ያካትታል።<a
          href="/food"
          class="topic-pill">🍜 ምግብ</a
        >ን ይመልከቱ፣ ስለ ንጥረ ነገሮች እና የማብሰያ ዘዴዎች ለማወቅ። ከቤተሰብ ግብዣ እስከ የመንገድ ዳር ምግብ፣
        ኢትዮጵያ ለምግብ ወዳጆች ብዙ የሚያቀርበው ነገር አላት፣ እያንዳንዱ ምግብ የራሱ ታሪክ ይይዛል።
      </p>

      <p>
        ከከፍተኛ ተራሮች እስከ ሰፊ ሜዳዎችና ብሄራዊ ፓርኮች፣ ኢትዮጵያ የበለጸገ የተፈጥሮ ስነ-ምህዳር ባለቤት ናት።
        ደኖች፣ ወንዞችና ሐይቆች—የብዙ ልዩ ልዩ እንስሳትና እፅዋት መኖሪያ ናቸው።
        <a href="/nature" class="topic-pill">🌿 የኢትዮጵያ ተፈጥሮ</a>ን በማየት የሚከተሉትን
        ማወቅ ይቻላል፦ ስለ ዱር እንስሳት፣ ስለ ተፈጥሮ ጥበቃ ጥረቶች፣ እና ስለ የአየር ንብረት ለውጥ፣ ደንና ውሃ ላይ
        ስላሉ ተግዳሮቶች። ይህንን ሀብት መጠበቅ፣ ለወደፊት ትውልዶች አስፈላጊ ኃላፊነት ነው።
      </p>

      <p>
        ብሄረሰብ፣ ቋንቋ፣ እምነትና ልማድ ሁሉም በጋራ የኢትዮጵያን ማህበራዊ ሸማ ይሸምናሉ፣
        <a href="/people" class="topic-pill">👥 የኢትዮጵያ ሰዎች</a>ን የሚያካትተው ይህ ታሪክ
        ሰፊ ነው። ከአርሶ አደሩ እስከ ከተማ ነዋሪው፣ ከወጣቱ ፈጣሪ እስከ ባህል ጠባቂው። እያንዳንዱ ግለሰብ ታሪክ፣
        የሀገሪቱን ትልቁን ገጽታ ያሳያል።
      </p>

      <p>
        ከጥንታዊ ሃይማኖታዊ ሥዕሎችና ቅርፃ ቅርጾች እስከ ዘመናዊ ጥበብ ድረስ፣
        <a href="/art" class="topic-pill">🎨 የኢትዮጵያ ጥበብ</a>ሰፊ ክልል ይሸፍናል። ባህላዊ
        የእጅ ስራዎች፣ ስዕል፣ እና የዘመናዊ አርቲስቶች ስራዎች—እርስ በርስ እንዴት ይነጋገራሉ፦ ትውፊት ለዘመናዊ ፈጠራ
