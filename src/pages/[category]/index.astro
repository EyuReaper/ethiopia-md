---
import { readdir, readFile } from 'fs/promises';
import { resolve, join, basename } from 'path';
import matter from 'gray-matter';
import Layout from '../../layouts/Layout.astro';
import { marked } from 'marked';
import { useTranslations, getLangFromUrl } from '../../i18n/utils';
import {
  categoryList as categories,
  getCategoryConfigs,
  type CategoryKey,
} from '../../utils/categoryConfig';

const safeMatter = (fileContent: string) => {
  try {
    return matter(fileContent);
  } catch {
    const stripped = fileContent.replace(/^---\s*\n[\s\S]*?\n---\s*\n/, '');
    return { data: {}, content: stripped };
  }
};

export async function getStaticPaths() {
  const safeMatter = (fileContent: string) => {
    try {
      return matter(fileContent);
    } catch {
      const stripped = fileContent.replace(/^---\s*\n[\s\S]*?\n---\s*\n/, '');
      return { data: {}, content: stripped };
    }
  };

  const categoryMapping: Record<string, string> = {
    history: 'History',
    geography: 'Geography',
    culture: 'Culture',
    food: 'Food',
    art: 'Art',
    music: 'Music',
    technology: 'Technology',
    nature: 'Nature',
    people: 'People',
    society: 'Society',
    economy: 'Economy',
    lifestyle: 'Lifestyle',
  };

  const paths = [];

  for (const category of categories) {
    const folderName = categoryMapping[category];
    const articles = [];

    try {
      const zhFolderPath = resolve(process.cwd(), 'knowledge', folderName);
      const zhFiles = await readdir(zhFolderPath);
      const zhMarkdownFiles = zhFiles.filter(
        (file) => file.endsWith('.md') && !file.startsWith('_'),
      );

      for (const file of zhMarkdownFiles) {
        const filePath = join(zhFolderPath, file);
        const fileContent = await readFile(filePath, 'utf-8');
        const { data: frontmatter } = safeMatter(fileContent);
        const slug = basename(file, '.md');
        if (frontmatter.status === 'draft' || frontmatter.status === 'archived')
          continue;

        articles.push({
          slug,
          title: frontmatter.title || slug,
          description: frontmatter.description || '',
          status: frontmatter.status || '',
          readingTime: frontmatter.readingTime || null,
          date: frontmatter.date || null,
          featured: frontmatter.featured || false,
          tags: frontmatter.tags || [],
          lang: 'am',
          image: frontmatter.image || null,
          imageAlt: frontmatter.imageAlt || '',
          imageCredit: frontmatter.imageCredit || '',
          subcategory: frontmatter.subcategory || '',
        });
      }
    } catch (err) {
      console.error(
        `[category/index] Error loading "${category}":`,
        (err as Error).message,
      );
    }

    let hubContent = '';
    try {
      const hubFolder = resolve(process.cwd(), 'knowledge', folderName);
      const hubFiles = await readdir(hubFolder);
      const hubFile = hubFiles.find(
        (f) => f.startsWith('_') && f.includes('Hub'),
      );
      if (hubFile) {
        const hubPath = join(hubFolder, hubFile);
        const hubRaw = await readFile(hubPath, 'utf-8');
        const { content } = safeMatter(hubRaw);
        hubContent = content.replace(/^#\s+.+\n/, '').trim();
      }
    } catch {}

    paths.push({
      params: { category },
      props: {
        category,
        hubContent,
        articles: articles.sort((a, b) => {
          if (a.featured && !b.featured) return -1;
          if (!a.featured && b.featured) return 1;
          return a.title.localeCompare(b.title);
        }),
      },
    });
  }

  return paths;
}

const { category, hubContent, articles } = Astro.props;

// Compute unique tags for filter
const allTagsSet = new Set();
articles.forEach((a: any) => {
  if (a.tags) a.tags.forEach((t: string) => allTagsSet.add(t));
});
const uniqueTags = [...allTagsSet].sort().slice(0, 12) as string[];

function resolveWikilinks(md: string, currentCategory: string) {
  if (!md) return md;

  function resolveOne(target: string, display?: string, bold = false) {
    const label = display || target;
    if (target.startsWith('_')) {
      const catName = target
        .replace(/^_/, '')
        .replace(/ Hub$/, '')
        .toLowerCase();
      return bold
        ? `<a class="topic-pill" href="/${catName}"><strong>${label}</strong></a>`
        : `<a class="topic-pill" href="/${catName}">${label}</a>`;
    }
    const matchArticle = articles.find(
      (a: any) =>
        a.title === target ||
        a.slug === target ||
        a.slug === encodeURIComponent(target),
    );
    if (matchArticle) {
      const url = `/${currentCategory}/${matchArticle.slug}`;
      return bold
        ? `<a class="topic-pill" href="${url}"><strong>${label}</strong></a>`
        : `<a class="topic-pill" href="${url}">${label}</a>`;
    }
    return bold ? `**${label}**` : label;
  }

  // First pass: **[[X]]** → [**resolved**](/url) (bold inside link for marked CJK compat)
  md = md.replace(
    /\*\*\[\[([^\]|]+?)(?:\|([^\]]+?))?\]\]\*\*/g,
    (_, target, display) => resolveOne(target, display, true),
  );
  // Second pass: remaining [[X]]
  md = md.replace(/\[\[([^\]|]+?)(?:\|([^\]]+?))?\]\]/g, (_, target, display) =>
    resolveOne(target, display),
  );
  return md;
}

const resolvedContent = hubContent
  ? resolveWikilinks(hubContent, category)
  : '';

// Build set of article URLs for topic-pill detection
const articleUrlSet = new Set(
  articles.map((a: any) => `/${category}/${a.slug}`),
);
// Also add cross-category hub URLs
const categoryKeys = Object.keys({
  history: 1,
  geography: 1,
  culture: 1,
  food: 1,
  art: 1,
  music: 1,
  technology: 1,
  nature: 1,
  people: 1,
  society: 1,
  economy: 1,
  lifestyle: 1,
});

// Broken image fallback + topic-pill link for hub pages
const hubRenderer = new marked.Renderer();
hubRenderer.image = ({ href, title, text }) => {
  const titleAttr = title ? ` title="${title}"` : '';
  const altText = text || '';
  return `<img src="${href}" alt="${altText}"${titleAttr} loading="lazy" onerror="this.onerror=null;this.classList.add('img-broken')" />`;
};
hubRenderer.link = ({ href, title, text }) => {
  const titleAttr = title ? ` title="${title}"` : '';
  const h = href || '';
  // Check if link points to an article or a hub category page
  const isArticleLink = articleUrlSet.has(decodeURIComponent(h));
  const isCategoryLink = categoryKeys.some(
    (k) => h === `/${k}` || h === `/${k}/`,
  );
  if (isArticleLink || isCategoryLink) {
    return `<a class="topic-pill" href="${h}"${titleAttr}>${text}</a>`;
  }
  return `<a href="${h}"${titleAttr}>${text}</a>`;
};
const rawHubHtml = resolvedContent
  ? marked.parse(resolvedContent, { renderer: hubRenderer, breaks: true })
  : '';

// Post-process: add callout/pull-quote classes to blockquotes
function enrichBlockquotes(html: string): string {
  if (!html) return html;
  const calloutMap: Record<string, string> = {
    '📝': 'callout-note',
    '⚠️': 'callout-warning',
    '💡': 'callout-tip',
    '📊': 'callout-data',
  };
  return (html as string).replace(
    /<blockquote>([\s\S]*?)<\/blockquote>/g,
    (match, inner) => {
      // Pull quote: contains ✦
      if (inner.includes('✦')) {
        return `<blockquote class="pull-quote">${inner}</blockquote>`;
      }
      // Callout: starts with emoji + bold
      for (const [emoji, cls] of Object.entries(calloutMap)) {
        if (inner.includes(emoji) && inner.includes('<strong>')) {
          return `<blockquote class="${cls}">${inner}</blockquote>`;
        }
      }
      return match;
    },
  );
}
const hubHtml = enrichBlockquotes(rawHubHtml as string);

// Group articles by subcategory
const subcategoryGroups: { name: string; articles: any[] }[] = [];
const subcatMap = new Map<string, any[]>();
for (const article of articles) {
  const sub = (article as any).subcategory || 'ያልተመደበ';
  if (!subcatMap.has(sub)) subcatMap.set(sub, []);
  subcatMap.get(sub)!.push(article);
}
// Sort: named subcategories first (alphabetically), then "ያልተመደበ" last
for (const [name, arts] of [...subcatMap.entries()].sort((a, b) => {
  if (a[0] === 'ያልተመደበ') return 1;
  if (b[0] === 'ያልተመደበ') return -1;
  return a[0].localeCompare(b[0]);
})) {
  subcategoryGroups.push({ name, articles: arts });
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const categoryConfigs = getCategoryConfigs(t);
const categoryInfo = categoryConfigs[category];

// Other categories (excluding the current one)
const otherCategories = categories
  .filter((cat) => cat !== category)
  .slice(0, 5) // show top 5
  .map((cat) => ({
    key: cat,
    ...categoryConfigs[cat as CategoryKey],
  }));
---

<Layout
  title={`${categoryInfo.name} - Ethiopia.md`}
  description={`${categoryInfo.description} - Ethiopia.md ጥልቅ የዕውቀት ምንጭ`}
  category={categoryInfo.name}
>
  <main class="category-page">
    <!-- Hero Banner -->
    <section
      class="hero-banner"
      style={`background: ${categoryInfo.gradient};`}
    >
      <div class="hero-content">
        <div class="hero-icon">{categoryInfo.icon}</div>
        <h1 class="hero-title">{categoryInfo.name}</h1>
        <p class="hero-description">{categoryInfo.description}</p>
        <div class="hero-stats">
          <span class="stats-badge">📚 {articles.length} ጽሑፎች</span>
        </div>
      </div>
      <div class="hero-decoration"></div>
    </section>

    <div class="container">
      <!-- Breadcrumb -->
      <nav class="breadcrumb">
        <a href="/" class="breadcrumb-link">መነሻ</a>
        <span class="separator">›</span>
        <span class="current">{categoryInfo.name}</span>
      </nav>

      <!-- Hub Content (curated overview) -->
      {
        hubHtml && (
          <section class="hub-content">
            <div class="hub-prose" set:html={hubHtml} />
          </section>
        )
      }

      <!-- Food Visualization (only for food category) -->
      {
        category === 'food' && (
          <section class="food-viz">
            <div class="food-viz-inner">
              <h2>🍜 የኢትዮጵያ የምግብ ባህል</h2>
              <p class="food-viz-subtitle">
                የምግብ ዘርፎችን ያስሱ፣ የኢትዮጵያን የጣዕም ዓለም ይወቁ
              </p>

              <div class="viz-tabs">
                <button class="viz-tab active" data-viz="sunburst">
                  🎯 ክብ ገበታ
                </button>
                <button class="viz-tab" data-viz="network">
                  🕸️ የግንኙነት ካርታ
                </button>
              </div>

              <div class="viz-container" id="sunburstViz">
                {/* D3 sunburst chart rendered here */}
              </div>
              <div class="viz-container" id="networkViz" style="display:none;">
                {/* D3 force graph rendered here */}
              </div>

              <div class="viz-legend" id="vizLegend">
                {/* Legend: 6 categories */}
              </div>
            </div>
          </section>
        )
      }

      <!-- Articles Section (grouped by subcategory) -->
      <h2 class="articles-heading">📖 ጽሑፎች</h2>

      {
        subcategoryGroups.length > 1 && (
          <nav class="subcategory-nav">
            {subcategoryGroups.map((group) => (
              <a href={`#sub-${group.name}`} class="subcategory-chip">
                {group.name}
                <span class="chip-count">{group.articles.length}</span>
              </a>
            ))}
          </nav>
        )
      }
      {
        articles.length > 0 ? (
          <section class="articles-section">
            {/* <!-- Sort & Filter Toolbar --> */}
            <div class="toolbar">
              <div class="toolbar-left">
                <div class="sort-group">
                  <span class="toolbar-label">ደርድር በ፦</span>
                  <button
                    class="sort-btn active"
                    data-sort="featured"
                    type="button"
                  >
                    ⭐ ተለይተው የቀረቡ
                  </button>
                  <button class="sort-btn" data-sort="title" type="button">
                    🔤 ርዕስ
                  </button>
                  <button class="sort-btn" data-sort="date" type="button">
                    🕐 ቀን
                  </button>
                  <button class="sort-btn" data-sort="reading" type="button">
                    📖 የንባብ ጊዜ
                  </button>
                </div>
              </div>
              <div class="toolbar-right">
                <div class="filter-group">
                  <input
                    type="text"
                    class="filter-input"
                    id="articleFilter"
                    placeholder="🔍 ጽሑፎችን ፈልግ..."
                    autocomplete="off"
                  />
                </div>
                <div class="tag-filter" id="tagFilter">
                  {uniqueTags.map((tag) => (
                    <button class="tag-btn" data-tag={tag} type="button">
                      {tag}
                    </button>
                  ))}
                </div>
              </div>
            </div>

            <div id="articlesGrid">
              {subcategoryGroups.map((group) => (
                <div class="subcategory-section" id={`sub-${group.name}`}>
                  {subcategoryGroups.length > 1 && (
                    <h3 class="subcategory-heading">
                      {group.name}
                      <span class="subcategory-count">
                        {group.articles.length}
                      </span>
                    </h3>
                  )}
                  <div class="articles-grid">
                    {group.articles.map((article: any, index: number) => (
                      <article
                        class={`article-card ${index === 0 && article.featured ? 'featured-card' : ''}`}
                        data-title={article.title}
                        data-date={article.date || ''}
                        data-reading={article.readingTime || 0}
                        data-featured={article.featured ? '1' : '0'}
                        data-tags={JSON.stringify(article.tags || [])}
                        data-lang={article.lang}
                        data-subcategory={article.subcategory || ''}
                      >
                        <a
                          href={`/${category}/${article.slug}`}
                          class="card-link"
                        >
                          {article.image ? (
                            <div class="card-image">
                              <img
                                src={article.image}
                                alt={article.imageAlt || article.title}
                                loading="lazy"
                              />
                            </div>
                          ) : (
                            <div
                              class="card-image-placeholder"
                              style={`background: ${categoryInfo.gradient};`}
                            >
                              <div class="card-image-icon">
                                {categoryInfo.icon}
                              </div>
                            </div>
                          )}

                          <div class="card-content">
                            <div class="card-header">
                              <div class="article-meta">
                                {article.status && (
                                  <span class="status-tag">
                                    {article.status}
                                  </span>
                                )}
                                {article.lang && (
                                  <span class="lang-tag">
                                    {article.lang === 'am' ? 'አማ' : 'EN'}
                                  </span>
                                )}
                              </div>
                              {article.featured && (
                                <div class="featured-badge">⭐ ተለይቶ የቀረበ</div>
                              )}
                            </div>

                            <h3 class="article-title">{article.title}</h3>

                            <p class="article-excerpt">{article.description}</p>

                            <div class="article-info">
                              {article.readingTime && (
                                <span class="info-item">
                                  📖 {article.readingTime} ደቂቃ ንባብ
                                </span>
                              )}
                            </div>
                          </div>
                        </a>
                      </article>
                    ))}
                  </div>
                </div>
              ))}
            </div>
            <div class="no-results" id="noResults" style="display:none;">
              <p>ምንም ውጤት አልተገኘም 😢</p>
            </div>
          </section>
        ) : (
          <section class="coming-soon">
            <div class="coming-soon-content">
              <div class="coming-soon-icon">{categoryInfo.icon}</div>
              <h2>በቅርቡ ይመጣል</h2>
              <p>ይህ ምድብ ገና ጽሑፎች የሉትም፣ በቅርቡ እንጨምራለን！</p>
              <p class="category-desc">ስለዚህ ምድብ፦{categoryInfo.description}</p>

              <div class="action-buttons">
                <a href="/" class="btn-primary">
                  ← ወደ መነሻ ገጽ ተመለስ
                </a>
                <a
                  href="https://github.com/EyuReaper/ethiopia-md"
                  target="_blank"
                  class="btn-secondary"
                >
                  አስተዋጽኦ ያድርጉ
                </a>
              </div>
            </div>
          </section>
        )
      }

      <!-- Explore other categories -->
      <section class="explore-more">
        <h2 class="explore-title">ሌሎች የኢትዮጵያ ምድቦችን ያስሱ</h2>
        <div class="categories-grid">
          {
            otherCategories.map((cat) => (
              <a
                href={`/${cat.key}`}
                class="category-card"
                style={`border-color: ${cat.color}; color: ${cat.color};`}
              >
                <div class="category-card-icon">{cat.icon}</div>
                <div class="category-card-name">{cat.name}</div>
              </a>
            ))
          }
        </div>
      </section>
    </div>
  </main>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const grid = document.getElementById('articlesGrid');
    const noResults = document.getElementById('noResults');
    const filterInput = document.getElementById(
      'articleFilter',
    ) as HTMLInputElement;
    if (!grid) return;

    const cards = Array.from(
      grid.querySelectorAll('.article-card'),
    ) as HTMLElement[];
    const subcategorySections = Array.from(
      grid.querySelectorAll('.subcategory-section'),
    ) as HTMLElement[];
    let activeSort = 'featured';
    let activeTag = '';

    // Sort
    function sortCards(method: string) {
      const sorted = [...cards].sort((a, b) => {
        if (method === 'featured') {
          const af = a.dataset.featured === '1' ? 1 : 0;
          const bf = b.dataset.featured === '1' ? 1 : 0;
          if (af !== bf) return bf - af;
          return (a.dataset.title || '').localeCompare(b.dataset.title || '');
        }
        if (method === 'title') {
          return (a.dataset.title || '').localeCompare(b.dataset.title || '');
        }
        if (method === 'date') {
          return (b.dataset.date || '').localeCompare(a.dataset.date || '');
        }
        if (method === 'reading') {
          return (
            parseInt(a.dataset.reading || '0') -
            parseInt(b.dataset.reading || '0')
          );
        }
        return 0;
      });
      sorted.forEach((card) => grid?.appendChild(card));
    }

    // Filter
    function applyFilters() {
      const query = filterInput?.value.toLowerCase() || '';
      let visible = 0;
      cards.forEach((card) => {
        const title = (card.dataset.title || '').toLowerCase();
        const tags: string[] = JSON.parse(card.dataset.tags || '[]');
        const matchQuery = !query || title.includes(query);
        const matchTag = !activeTag || tags.includes(activeTag);
        const show = matchQuery && matchTag;
        card.style.display = show ? '' : 'none';
        // Reset featured-card class based on visibility
        if (show) visible++;
      });
      // Hide subcategory sections with no visible cards
      subcategorySections.forEach((section) => {
        const sectionCards = section.querySelectorAll(
          '.article-card',
        ) as NodeListOf<HTMLElement>;
        const anyVisible = Array.from(sectionCards).some(
          (c) => c.style.display !== 'none',
        );
        section.style.display = anyVisible ? '' : 'none';
      });
      if (noResults) {
        noResults.style.display = visible === 0 ? 'block' : 'none';
      }
    }

    // Sort buttons
    document.querySelectorAll('.sort-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        document
          .querySelectorAll('.sort-btn')
          .forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        activeSort = (btn as HTMLElement).dataset.sort || 'featured';
        sortCards(activeSort);
      });
    });

    // Tag buttons
    document.querySelectorAll('.tag-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const tag = (btn as HTMLElement).dataset.tag || '';
        if (activeTag === tag) {
          activeTag = '';
          btn.classList.remove('active');
        } else {
          document
            .querySelectorAll('.tag-btn')
            .forEach((b) => b.classList.remove('active'));
          activeTag = tag;
          btn.classList.add('active');
        }
        applyFilters();
      });
    });

    // Text filter
    filterInput?.addEventListener('input', () => {
      applyFilters();
    });
  });
</script>

<style
  define:vars={{
    categoryColor: categoryInfo.color,
    categoryColorLight: categoryInfo.colorLight,
  }}
>
  .category-page {
    min-height: 100vh;
  }

  /* Hero Banner */
  .hero-banner {
    position: relative;
    width: 100%;
    padding: clamp(3.5rem, 8vw, 5rem) var(--space-page-x);
    color: white;
    text-align: center;
    overflow: hidden;
  }

  .hero-content {
    max-width: 800px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  .hero-icon {
    font-size: 4rem;
    margin-bottom: 1rem;
    animation: float 3s ease-in-out infinite;
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  .hero-title {
    font-size: 3.5rem;
    font-weight: 800;
    margin-bottom: 1rem;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
    background: linear-gradient(
      45deg,
      rgba(255, 255, 255, 1),
      rgba(255, 255, 255, 0.8)
    );
    background-clip: text;
    -webkit-background-clip: text;
  }

  .hero-description {
    font-size: 1.5rem;
    margin-bottom: 2rem;
    opacity: 0.95;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
    line-height: 1.4;
  }

  .hero-stats {
    display: flex;
    justify-content: center;
    gap: 1rem;
  }

  .stats-badge {
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    padding: 0.7rem 1.15rem;
    border-radius: var(--radius-chip);
    font-weight: 500;
    box-shadow: 0 8px 22px rgba(15, 23, 42, 0.06);
  }

  .hero-decoration {
    position: absolute;
    top: 0;
    right: -10%;
    width: 50%;
    height: 100%;
    background: radial-gradient(
      circle,
      rgba(255, 255, 255, 0.1) 0%,
      transparent 70%
    );
    border-radius: 50%;
  }

  /* Container */
  .container {
    max-width: var(--container-page);
    margin: 0 auto;
    padding: 2rem var(--space-page-x);
  }

  /* Breadcrumb */
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: var(--space-7);
    font-size: 0.9rem;
  }

  .breadcrumb a {
    color: var(--categoryColor);
    text-decoration: none;
    font-weight: 500;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  .separator {
    color: #9ca3af;
  }

  .current {
    color: #6b7280;
    font-weight: 600;
  }

  /* Articles Grid */
  .hub-content {
    margin: var(--space-5) 0 var(--space-7);
    padding: var(--space-6);
    background: rgba(255, 255, 255, 0.88);
    border-radius: 24px;
    border: 1px solid #e2e8f0;
    box-shadow: var(--shadow-soft);
    backdrop-filter: blur(10px);
  }
  .hub-prose {
    font-size: 1.05rem;
    line-height: 2;
    color: #334155;
    max-width: 840px;
    margin: 0 auto;
  }
  .hub-prose :global(h1:first-child) {
    display: none;
  }
  .hub-prose :global(blockquote:first-child) {
    font-size: 1.15rem;
    font-style: normal;
    font-weight: 600;
    border-left: 4px solid #4a7c28;
    padding: 1rem 1.5rem;
    margin: 0 0 2rem 0;
    background: #f0f7ee;
    border-radius: 0 8px 8px 0;
    color: #2d5016;
    line-height: 1.9;
  }
  .hub-prose :global(blockquote) {
    border-left: 4px solid #4a7c28;
    background: linear-gradient(to right, rgba(26, 60, 52, 0.04), transparent);
    margin: 2.5rem 0;
    padding: 1.5rem 1.75rem;
    border-radius: 0 12px 12px 0;
    font-style: italic;
    color: #3a4f44;
    font-size: 1.05rem;
  }
  .hub-prose :global(blockquote p) {
    margin-bottom: 0;
  }

  /* Callout blockquotes */
  .hub-prose :global(blockquote.callout-note) {
    border-left-color: #3b82f6;
    background: linear-gradient(
      to right,
      rgba(59, 130, 246, 0.06),
      transparent
    );
    font-style: normal;
  }
  .hub-prose :global(blockquote.callout-warning) {
    border-left-color: #f59e0b;
    background: linear-gradient(
      to right,
      rgba(245, 158, 11, 0.06),
      transparent
    );
    font-style: normal;
  }
  .hub-prose :global(blockquote.callout-tip) {
    border-left-color: #10b981;
    background: linear-gradient(
      to right,
      rgba(16, 185, 129, 0.06),
      transparent
    );
    font-style: normal;
  }
  .hub-prose :global(blockquote.callout-data) {
    border-left-color: #8b5cf6;
    background: linear-gradient(
      to right,
      rgba(139, 92, 246, 0.06),
      transparent
    );
    font-style: normal;
  }

  /* Pull quote */
  .hub-prose :global(blockquote.pull-quote) {
    border-left: none;
    background: none;
    text-align: center;
    font-size: 1.35rem;
    font-weight: 600;
    font-style: normal;
    color: #1a3c34;
    padding: 2rem 2.5rem;
    margin: 3rem auto;
    max-width: 680px;
    line-height: 1.8;
    position: relative;
  }
  .hub-prose :global(blockquote.pull-quote)::before {
    content: '';
    display: block;
    width: 60px;
    height: 3px;
    background: #4a7c28;
    margin: 0 auto 1.5rem;
    border-radius: 2px;
  }
  .hub-prose :global(blockquote.pull-quote)::after {
    content: '';
    display: block;
    width: 60px;
    height: 3px;
    background: #4a7c28;
    margin: 1.5rem auto 0;
    border-radius: 2px;
  }

  .hub-prose :global(h2) {
    font-size: var(--title-subsection-size);
    font-weight: 800;
    margin: 4rem 0 1.2rem;
    color: #1a1a2e;
    padding-bottom: 0.6rem;
    border-bottom: 2px solid #e2e8f0;
    letter-spacing: var(--title-letter-spacing);
    line-height: var(--title-line-height);
    font-family: var(--font-editorial);
  }
  .hub-prose :global(h3) {
    font-size: var(--title-minor-size);
    font-weight: 700;
    margin: 3rem 0 0.75rem;
    color: #334155;
    line-height: 1.4;
    letter-spacing: 0.02em;
    font-family: var(--font-editorial);
  }
  .hub-prose :global(p) {
    margin: 1.1rem 0;
    text-align: justify;
    color: #2c2c2c;
  }
  .hub-prose :global(ul) {
    list-style: disc;
    padding-left: 1.5rem;
    margin-bottom: 1.1rem;
  }
  .hub-prose :global(ol) {
    list-style: decimal;
    padding-left: 1.5rem;
    margin-bottom: 1.1rem;
  }
  .hub-prose :global(li) {
    margin-bottom: 0.3rem;
    line-height: 1.65;
  }
  .hub-prose :global(a) {
    color: #334155;
    text-decoration: none;
    border-bottom: 1.5px solid #94a3b8;
    padding-bottom: 1px;
    transition: all 0.2s;
  }
  .hub-prose :global(a:hover) {
    color: #1a1a2e;
    border-bottom-color: #1a1a2e;
  }

  /* Hub wikilinks as topic-pill */
  .hub-prose :global(a.topic-pill) {
    display: inline-block;
    background: rgba(45, 80, 22, 0.08);
    border: 1.5px solid rgba(45, 80, 22, 0.2);
    border-radius: 6px;
    padding: 0.15rem 0.6rem;
    font-weight: 700;
    color: #2d5016;
    white-space: nowrap;
    text-decoration: none;
    transition: all 0.25s ease;
    border-bottom: none;
  }
  .hub-prose :global(a.topic-pill:hover) {
    background: rgba(45, 80, 22, 0.15);
    border-color: rgba(45, 80, 22, 0.4);
    transform: translateY(-1px);
    box-shadow: 0 2px 6px rgba(45, 80, 22, 0.15);
    color: #2d5016;
  }

  .hub-prose :global(code) {
    font-family: 'Courier New', monospace;
    font-size: 0.88em;
    background: rgba(26, 60, 52, 0.06);
    color: #1a3c34;
    padding: 0.15em 0.45em;
    border-radius: 4px;
  }
  .hub-prose :global(pre) {
    background: #1a3c34;
    color: #f8f1e9;
    padding: 1.5rem;
    border-radius: 12px;
    overflow-x: auto;
    margin: 2rem 0;
    font-size: 0.875rem;
  }
  .hub-prose :global(pre code) {
    background: transparent;
    color: inherit;
    padding: 0;
    font-size: inherit;
  }

  .hub-prose :global(img) {
    width: 100%;
    max-height: 480px;
    object-fit: cover;
    border-radius: 12px;
    margin: 2rem 0;
    box-shadow: 0 4px 24px rgba(26, 60, 52, 0.1);
  }
  .hub-prose :global(img.img-broken) {
    min-height: 120px;
    background: rgba(26, 60, 52, 0.04);
    border: 2px dashed rgba(26, 60, 52, 0.15);
    border-radius: 12px;
  }
  .hub-prose :global(em) {
    font-size: 0.85rem;
    color: #64748b;
    display: block;
    text-align: center;
    margin: -1rem 0 1.5rem;
  }
  .hub-prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 2rem 0;
    font-size: 0.9rem;
  }
  .hub-prose :global(th) {
    background: rgba(26, 60, 52, 0.05);
    color: #1a3c34;
    font-weight: 600;
    text-align: left;
    padding: 0.75rem 1rem;
    border-bottom: 2px solid rgba(26, 60, 52, 0.12);
  }
  .hub-prose :global(td) {
    padding: 0.65rem 1rem;
    border-bottom: 1px solid rgba(26, 60, 52, 0.06);
    color: #3a4f44;
  }
  .hub-prose :global(tr:hover td) {
    background: rgba(26, 60, 52, 0.02);
  }
  .hub-prose :global(strong) {
    font-weight: 700;
    color: #1a3c34;
  }
  .hub-prose :global(hr) {
    border: none;
    border-top: 1px solid rgba(26, 60, 52, 0.1);
    margin: 3rem 0;
  }

  .articles-heading {
    font-size: var(--title-subsection-size);
    margin: 0 0 var(--space-5) 0;
    color: #1e293b;
    font-weight: 800;
    line-height: var(--title-line-height);
    letter-spacing: var(--title-letter-spacing);
    font-family: var(--font-editorial);
  }

  .articles-section {
    margin-bottom: var(--space-8);
  }

  /* Subcategory Navigation */
  .subcategory-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
    padding: 1rem;
    background: #f8fafc;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
  }

  .subcategory-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.85rem;
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    font-size: 0.85rem;
    color: #475569;
    text-decoration: none;
    font-weight: 500;
    transition: all 0.2s;
  }

  .subcategory-chip:hover {
    border-color: var(--categoryColor);
    color: var(--categoryColor);
    background: var(--categoryColorLight);
  }

  .chip-count {
    background: #e2e8f0;
    color: #64748b;
    padding: 0.1rem 0.45rem;
    border-radius: 10px;
    font-size: 0.72rem;
    font-weight: 600;
  }

  /* Subcategory Section */
  .subcategory-section {
    margin-bottom: 2.5rem;
  }

  .subcategory-heading {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.3rem;
    font-weight: 700;
    color: #1e293b;
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--categoryColor);
    font-family: var(--font-editorial);
    letter-spacing: var(--title-letter-spacing);
  }

  .subcategory-count {
    background: var(--categoryColorLight);
    color: var(--categoryColor);
    padding: 0.15rem 0.55rem;
    border-radius: 10px;
    font-size: 0.78rem;
    font-weight: 600;
  }

  /* Toolbar */
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: flex-start;
    margin-bottom: 1.5rem;
    padding: 1rem;
    background: #f8fafc;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
  }

  .toolbar-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .toolbar-right {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-left: auto;
  }

  .toolbar-label {
    font-size: 0.8rem;
    color: #64748b;
    font-weight: 600;
    white-space: nowrap;
  }

  .sort-group {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .sort-btn {
    padding: 0.35rem 0.65rem;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    background: white;
    font-size: 0.78rem;
    color: #64748b;
    cursor: pointer;
    transition: all 0.15s;
    white-space: nowrap;
  }

  .sort-btn:hover {
    border-color: var(--categoryColor);
    color: var(--categoryColor);
  }

  .sort-btn.active {
    background: var(--categoryColor);
    color: white;
    border-color: var(--categoryColor);
  }

  .filter-input {
    padding: 0.4rem 0.75rem;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    font-size: 0.85rem;
    width: 180px;
    outline: none;
    transition: border-color 0.15s;
  }

  .filter-input:focus {
    border-color: var(--categoryColor);
    box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.05);
  }

  .tag-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .tag-btn {
    padding: 0.25rem 0.5rem;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    background: white;
    font-size: 0.72rem;
    color: #94a3b8;
    cursor: pointer;
    transition: all 0.15s;
  }

  .tag-btn:hover {
    border-color: var(--categoryColor);
    color: var(--categoryColor);
  }

  .tag-btn.active {
    background: var(--categoryColorLight);
    color: var(--categoryColor);
    border-color: var(--categoryColor);
  }

  .no-results {
    text-align: center;
    padding: 3rem 1rem;
    color: #94a3b8;
    font-size: 1.1rem;
  }

  @media (max-width: 768px) {
    .toolbar {
      flex-direction: column;
    }
    .toolbar-right {
      margin-left: 0;
      width: 100%;
    }
    .filter-input {
      width: 100%;
    }
    .sort-group {
      flex-wrap: wrap;
    }
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-5);
  }

  .article-card {
    background: rgba(255, 255, 255, 0.92);
    border-radius: 22px;
    overflow: hidden;
    box-shadow: var(--shadow-soft);
    transition:
      transform 0.22s ease,
      box-shadow 0.22s ease,
      border-color 0.22s ease;
    border: 1px solid rgba(0, 0, 0, 0.08);
    backdrop-filter: blur(10px);
  }

  .article-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card);
    border-color: rgba(148, 163, 184, 0.28);
  }

  .featured-card {
    grid-column: 1 / -1;
    max-width: 680px;
    margin: 0 auto;
  }

  .card-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .card-image-placeholder {
    height: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .card-image {
    height: 160px;
    overflow: hidden;
    border-radius: 22px 22px 0 0;
    position: relative;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .article-card:hover .card-image img {
    transform: scale(1.05);
  }

  .featured-card .card-image-placeholder {
    height: 200px;
  }

  .featured-card .card-image {
    height: 200px;
  }

  .card-image-icon {
    font-size: 3rem;
    opacity: 0.8;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.3));
  }

  .card-content {
    padding: 1.5rem;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
  }

  .article-meta {
    display: flex;
    gap: 0.55rem;
    flex-wrap: wrap;
  }

  .status-tag {
    background: var(--categoryColorLight);
    color: var(--categoryColor);
    padding: 0.45rem 0.8rem;
    border-radius: var(--radius-chip);
    font-size: 0.8rem;
    font-weight: 500;
    border: 1px solid rgba(148, 163, 184, 0.14);
  }

  .lang-tag {
    background: rgba(255, 255, 255, 0.72);
    color: #64748b;
    padding: 0.45rem 0.8rem;
    border-radius: var(--radius-chip);
    font-size: 0.8rem;
    font-weight: 500;
    border: 1px solid rgba(148, 163, 184, 0.18);
  }

  .featured-badge {
    background: linear-gradient(45deg, #fbbf24, #f59e0b);
    color: white;
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius-chip);
    font-size: 0.8rem;
    font-weight: 600;
    box-shadow: 0 8px 22px rgba(245, 158, 11, 0.18);
  }

  .article-title {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 1rem;
    color: #1f2937;
  }

  .featured-card .article-title {
    font-size: 1.8rem;
  }

  .article-excerpt {
    color: #6b7280;
    line-height: 1.6;
    margin-bottom: 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-info {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .info-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 0.8rem;
    font-size: 0.85rem;
    color: #64748b;
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: var(--radius-chip);
    box-shadow: 0 8px 22px rgba(15, 23, 42, 0.04);
  }

  /* Coming Soon */
  .coming-soon {
    text-align: center;
    padding: var(--space-8) var(--space-5);
  }

  .coming-soon-content {
    max-width: 500px;
    margin: 0 auto;
  }

  .coming-soon-icon {
    font-size: 5rem;
    margin-bottom: 2rem;
    opacity: 0.7;
  }

  .coming-soon-content h2 {
    font-size: var(--title-section-size);
    color: #1f2937;
    margin-bottom: 1rem;
    font-weight: 800;
    line-height: var(--title-line-height);
    letter-spacing: var(--title-letter-spacing);
    font-family: var(--font-editorial);
  }

  .coming-soon-content p {
    color: var(--copy-intro-color);
    margin-bottom: 1.5rem;
    line-height: var(--copy-intro-line);
    font-size: var(--copy-intro-size);
  }

  .category-desc {
    font-style: italic;
    color: var(--categoryColor);
    margin-bottom: 3rem !important;
    font-weight: 500;
  }

  .action-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.95rem 1.6rem;
    text-decoration: none;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.95rem;
    justify-content: center;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      background 0.2s ease,
      border-color 0.2s ease;
  }

  .btn-primary {
    background: var(--categoryColor);
    color: white;
    border: 1px solid var(--categoryColor);
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.12);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
  }

  .btn-secondary {
    background: white;
    color: var(--categoryColor);
    border: 1px solid var(--categoryColor);
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08);
  }

  .btn-secondary:hover {
    background: var(--categoryColor);
    color: white;
    transform: translateY(-2px);
  }

  /* Explore More */
  .explore-more {
    margin-top: var(--space-9);
    padding: var(--space-7) 0;
    border-top: 1px solid #e5e7eb;
  }

  .explore-title {
    text-align: center;
    font-size: var(--title-section-size);
    font-weight: 800;
    color: #1f2937;
    margin-bottom: 2rem;
    line-height: var(--title-line-height);
    letter-spacing: var(--title-letter-spacing);
    font-family: var(--font-editorial);
  }

  .categories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }

  .category-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 2rem 1rem;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid;
    border-radius: 22px;
    text-decoration: none;
    transition:
      transform 0.22s ease,
      box-shadow 0.22s ease;
    text-align: center;
    box-shadow: var(--shadow-soft);
  }

  .category-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card);
  }

  .category-card-icon {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }

  .category-card-name {
    font-weight: 600;
    font-size: 1.1rem;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero-banner {
      padding: var(--space-7) 1rem;
    }

    .hero-title {
      font-size: 2.5rem;
    }

    .hero-description {
      font-size: 1.2rem;
    }

    .container {
      padding: 1rem;
    }

    .hub-content {
      padding: 1.5rem 1.25rem;
      border-radius: 20px;
    }

    .articles-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .featured-card {
      grid-column: 1;
    }

    .action-buttons {
      flex-direction: column;
      align-items: center;
    }

    .categories-grid {
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    }
  }

  /* Food Visualization */
  .food-viz {
    padding: 48px 0;
    background: linear-gradient(135deg, #fdf6ec 0%, #fff5f5 100%);
    border-radius: 16px;
    margin: 32px 0;
  }
  .food-viz-inner {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 24px;
    text-align: center;
  }
  .food-viz h2 {
    font-size: 2.2rem;
    font-weight: 800;
