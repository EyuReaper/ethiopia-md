---
import Layout from '../layouts/Layout.astro';
import { readdir, readFile } from 'fs/promises';
import { resolve, join } from 'path';
import matter from 'gray-matter';

const categories = [
  'history',
  'geography',
  'culture',
  'food',
  'art',
  'music',
  'technology',
  'nature',
  'people',
  'society',
  'economy',
  'lifestyle',
];

const categoryColors: Record<string, string> = {
  history: '#e74c3c',
  geography: '#2ecc71',
  culture: '#9b59b6',
  food: '#f39c12',
  art: '#e91e63',
  music: '#00bcd4',
  technology: '#3498db',
  nature: '#27ae60',
  people: '#ff9800',
  society: '#607d8b',
  economy: '#ff5722',
  lifestyle: '#8bc34a',
};

const categoryNames: Record<string, string> = {
  history: '📜 ታሪክ',
  geography: '🗺️ ጂኦግራፊ',
  culture: '🎭 ባህል',
  food: '🍜 ምግብ',
  art: '🎨 ጥበብ',
  music: '🎵 ሙዚቃ',
  technology: '💻 ቴክኖሎጂ',
  nature: '🌿 ተፈጥሮ',
  people: '👥 ሰዎች',
  society: '⚖️ ማህበረሰብ',
  economy: '📈 ኢኮኖሚ',
  lifestyle: '🏠 አኗኗር',
};

const categoryMapping: Record<string, string> = {
  history: 'History',
  geography: 'Geography',
  culture: 'Culture',
  food: 'Food',
  art: 'Art',
  music: 'Music',
  technology: 'Technology',
  nature: 'Nature',
  people: 'People',
  society: 'Society',
  economy: 'Economy',
  lifestyle: 'Lifestyle',
};

// Build nodes and edges
const nodes: any[] = [];
const edges: any[] = [];
const tagMap: Record<string, string[]> = {}; // tag → article ids

// Read straight from the knowledge/ SSOT (not src/content/, which is a
// synced mirror that scripts/core/sync.sh only ever adds to and never
// prunes — reading it directly would surface stale orphaned files that no
// longer exist in knowledge/, on top of not knowing about `status` at all).
// Many archived/corrupted files have malformed YAML (unescaped commas or
// brackets from the placeholder-corruption text) that gray-matter can't
// parse at all. Falling back to `{}` on a parse error would make `status`
// undefined — i.e. NOT 'archived', so the file would silently bypass the
// filter below. Returning null instead lets the caller skip it outright.
const safeMatter = (fileContent: string) => {
  try {
    return matter(fileContent);
  } catch {
    return null;
  }
};

// Some archived files have unquoted `title: [placeholder text]` in YAML,
// which parses as a one-element array rather than a string.
function coerceTitle(value: unknown, fallback: string): string {
  if (typeof value === 'string' && value.trim()) return value;
  if (Array.isArray(value) && value.length) return String(value[0]);
  return fallback;
}

async function loadCategoryArticles(cat: string) {
  const folder = categoryMapping[cat];
  const dir = resolve(process.cwd(), 'knowledge', folder);
  const articles: {
    id: string;
    data: { title: string; tags: string[]; subcategory: string };
  }[] = [];
  try {
    const files = await readdir(dir);
    for (const file of files) {
      if (!file.endsWith('.md') || file.startsWith('_')) continue;
      const slug = file.replace(/\.md$/, '');
      const raw = await readFile(join(dir, file), 'utf-8');
      const parsed = safeMatter(raw);
      if (!parsed) continue;
      const frontmatter = parsed.data;
      if (frontmatter.status === 'archived' || frontmatter.status === 'draft')
        continue;
      articles.push({
        id: `${cat}/${slug}`,
        data: {
          title: coerceTitle(frontmatter.title, slug),
          tags: Array.isArray(frontmatter.tags) ? frontmatter.tags : [],
          subcategory:
            typeof frontmatter.subcategory === 'string'
              ? frontmatter.subcategory
              : '',
        },
      });
    }
  } catch {}
  return articles;
}

// Center node
nodes.push({ id: 'ethiopia', label: 'Ethiopia.md', group: 'center', size: 30 });

// Special nodes
nodes.push({
  id: 'about',
  label: '📖 ስለ እኛ',
  group: 'special',
  color: '#6366f1',
  size: 14,
  url: '/about',
});
nodes.push({
  id: 'contribute',
  label: '✋ ተሳትፎ',
  group: 'special',
  color: '#22c55e',
  size: 14,
  url: '/contribute',
});
edges.push({ source: 'ethiopia', target: 'about' });
edges.push({ source: 'ethiopia', target: 'contribute' });

for (const cat of categories) {
  const catArticles = await loadCategoryArticles(cat);

  // Category node
  nodes.push({
    id: cat,
    label: categoryNames[cat] || cat,
    group: cat,
    color: categoryColors[cat],
    size: 20,
    url: `/${cat}`,
  });
  edges.push({ source: 'ethiopia', target: cat });

  // Track subcategories for this category
  const subcatSet = new Set<string>();

  for (const article of catArticles) {
    const slug = article.id.split('/').slice(1).join('/').replace(/\.md$/, '');
    const nodeId = `${cat}/${slug}`;
    const subcat = article.data.subcategory || '';

    nodes.push({
      id: nodeId,
      label: article.data.title,
      group: cat,
      color: categoryColors[cat],
      size: 8,
      url: `/${cat}/${encodeURIComponent(slug)}`,
    });

    if (subcat) {
      // Create subcategory virtual node if not exists
      const subcatId = `${cat}/__sub__${subcat}`;
      if (!subcatSet.has(subcat)) {
        subcatSet.add(subcat);
        nodes.push({
          id: subcatId,
          label: subcat,
          group: cat,
          color: categoryColors[cat],
          size: 5,
          isSubcategory: true,
        });
        edges.push({ source: cat, target: subcatId });
      }
      // Article → subcategory
      edges.push({ source: subcatId, target: nodeId });
    } else {
      // No subcategory → connect directly to category
      edges.push({ source: cat, target: nodeId });
    }

    // Build tag connections
    if (article.data.tags) {
      for (const tag of article.data.tags) {
        if (!tagMap[tag]) tagMap[tag] = [];
        tagMap[tag].push(nodeId);
      }
    }
  }
}

// Cross-category edges via shared tags (max 3 per tag to limit O(n²) explosion)
for (const [tag, articleIds] of Object.entries(tagMap)) {
  if (articleIds.length >= 2) {
    let count = 0;
    for (let i = 0; i < articleIds.length - 1 && count < 3; i++) {
      for (let j = i + 1; j < articleIds.length && count < 3; j++) {
        const catA = articleIds[i].split('/')[0];
        const catB = articleIds[j].split('/')[0];
        if (catA !== catB) {
          edges.push({ source: articleIds[i], target: articleIds[j] });
          count++;
        }
      }
    }
  }
}

// Parse Hub wikilinks to create Hub→article edges
const nodeIds = new Set(nodes.map((n) => n.id));

for (const [cat, folder] of Object.entries(categoryMapping)) {
  try {
    const hubDir = resolve(process.cwd(), 'knowledge', folder);
    const files = await readdir(hubDir);
    const hubFile = files.find((f) => f.startsWith('_') && f.includes('Hub'));
    if (hubFile) {
      const content = await readFile(join(hubDir, hubFile), 'utf-8');
      // Extract [[wikilink]] references
      const wikilinks =
        content.match(/\[\[([^\]|]+?)(?:\|[^\]]+?)?\]\]/g) || [];
      for (const wl of wikilinks) {
        const target = wl
          .replace(/\[\[/, '')
          .replace(/\]\]/, '')
          .split('|')[0]
          .trim();
        // Check if target matches an article node
        const matchNode = nodes.find(
          (n) =>
            n.label === target ||
            n.label === `🌐 ${target}` ||
            n.id === `${cat}/${target}` ||
            n.id === `${cat}/${encodeURIComponent(target)}`,
        );
        if (matchNode && matchNode.id !== cat) {
          // Avoid duplicate edges
          const exists = edges.some(
            (e) =>
              (e.source === cat && e.target === matchNode.id) ||
              (e.source === matchNode.id && e.target === cat),
          );
          if (!exists) {
            edges.push({ source: cat, target: matchNode.id });
          }
        }
        // Cross-category Hub links (e.g. History Hub mentions [[Article Title]])
        if (!matchNode) {
          for (const [otherCat] of Object.entries(categoryMapping)) {
            if (otherCat === cat) continue;
            const crossNode = nodes.find(
              (n) => n.label === target && n.group === otherCat,
            );
            if (crossNode) {
              edges.push({ source: cat, target: crossNode.id });
              break;
            }
          }
        }
      }
    }
  } catch {}
}

const graphData = JSON.stringify({ nodes, edges });
---

<Layout title="🕸️ የዕውቀት ግራፍ — Ethiopia.md">
  <main class="graph-page">
    <div class="graph-header">
      <h1>🕸️ የዕውቀት ግራፍ Knowledge Graph</h1>
      <p>Ethiopia.md ውስጥ ያሉ ርዕሰ ጉዳዮች እርስ በርስ እንዴት እንደሚተሳሰሩ ይመልከቱ</p>
      <div class="search-box">
        <input
          id="graph-search"
          type="search"
          placeholder="ርዕሶችን ፈልግ..."
          aria-label="ርዕሶችን ፈልግ"
        />
        <span id="search-count" class="search-count"></span>
      </div>
    </div>
    <div id="graph-container"></div>
    <div id="tooltip" class="tooltip"></div>
  </main>
</Layout>

<script define:vars={{ graphData }}>
  const data = JSON.parse(graphData);

  const script = document.createElement('script');
  script.src = 'https://d3js.org/d3.v7.min.js';
  script.onload = () => initGraph(data);
  document.head.appendChild(script);

  function initGraph(data) {
    const container = document.getElementById('graph-container');
    const width = container.clientWidth;
    const height = container.clientHeight;
    const isCompact = width < 768;

    const svg = d3
      .select('#graph-container')
      .append('svg')
      .attr('width', width)
      .attr('height', height);

    const g = svg.append('g');

    // Zoom
    const zoomBehavior = d3.zoom().on('zoom', (event) => {
      g.attr('transform', event.transform);
    });
    svg.call(zoomBehavior);

    function zoomToFit() {
      const bounds = g.node().getBBox();
      const midX = bounds.x + bounds.width / 2;
      const midY = bounds.y + bounds.height / 2;
      const scale =
        0.85 / Math.max(bounds.width / width, bounds.height / height);
      svg
        .transition()
        .duration(750)
        .call(
          zoomBehavior.transform,
          d3.zoomIdentity
            .translate(width / 2 - scale * midX, height / 2 - scale * midY)
            .scale(scale),
        );
    }

    // Fix ethiopia node at center
    const ethiopiaNode = data.nodes.find((n) => n.id === 'ethiopia');
    if (ethiopiaNode) {
      ethiopiaNode.fx = width / 2;
      ethiopiaNode.fy = height / 2;
    }

    const simulation = d3
      .forceSimulation(data.nodes)
      .force(
        'link',
        d3
          .forceLink(data.edges)
          .id((d) => d.id)
          .distance((d) => {
            if (d.source.id === 'ethiopia' || d.target.id === 'ethiopia')
              return 700;
            // Subcategory ↔ article: tight
            if (d.source.isSubcategory || d.target.isSubcategory) return 40;
            // Same group: medium
            if (
              d.source.group &&
              d.target.group &&
              d.source.group === d.target.group
            )
              return 60;
            return 250;
          })
          .strength(1),
      )
      .force('charge', d3.forceManyBody().strength(-120))
      .force('center', d3.forceCenter(width / 2, height / 2))
      .force(
        'collision',
        d3.forceCollide().radius((d) => d.size + 3),
      );

    // Links
    const link = g
      .append('g')
      .selectAll('line')
      .data(data.edges)
      .join('line')
      .attr('stroke', '#ddd')
      .attr('stroke-width', 1)
      .attr('stroke-opacity', 0.5);

    // Nodes
    const node = g
      .append('g')
      .selectAll('circle')
      .data(data.nodes)
      .join('circle')
      .attr('r', (d) => d.size)
      .attr('fill', (d) => {
        if (d.group === 'center') return '#1a1a2e';
        if (d.isSubcategory) return d.color + 'cc'; // slightly transparent
        return d.color || '#ccc';
      })
      .attr('stroke', (d) => (d.isSubcategory ? d.color : '#fff'))
      .attr('stroke-width', (d) => (d.isSubcategory ? 1.5 : 2))
      .attr('cursor', 'pointer')
      .call(
        d3
          .drag()
          .on('start', (event, d) => {
            if (!event.active) simulation.alphaTarget(0.3).restart();
            d.fx = d.x;
            d.fy = d.y;
          })
          .on('drag', (event, d) => {
            d.fx = event.x;
            d.fy = event.y;
          })
          .on('end', (event, d) => {
            if (!event.active) simulation.alphaTarget(0);
            if (d.id !== 'ethiopia') {
              d.fx = null;
              d.fy = null;
            }
          }),
      );

    // Labels
    const label = g
      .append('g')
      .selectAll('text')
      .data(data.nodes)
      .join('text')
      .text((d) => d.label)
      .attr('font-size', (d) => {
        if (d.group === 'center') return isCompact ? '14px' : '16px';
        if (d.size >= 20) return isCompact ? '12px' : '13px';
        if (d.isSubcategory) return isCompact ? '7px' : '8px';
        return isCompact ? '9px' : '9px';
      })
      .attr('font-weight', (d) => (d.size >= 14 ? 'bold' : 'normal'))
      .attr('text-anchor', 'middle')
      .attr('dy', (d) => d.size + 14)
      .attr('fill', '#333')
      .attr('filter', 'drop-shadow(0 1px 2px rgba(255,255,255,0.8))')
      .attr('pointer-events', 'none');

    // Click
    node.on('click', (event, d) => {
      if (d.url) window.location.href = d.url;
    });

    // Hover
    const tooltip = document.getElementById('tooltip');
    node
      .on('mouseover', (event, d) => {
        tooltip.textContent = d.label;
        tooltip.style.display = 'block';
        tooltip.style.left = event.pageX + 10 + 'px';
        tooltip.style.top = event.pageY - 10 + 'px';
        d3.select(event.target)
          .attr('stroke', '#3b82f6')
          .attr('stroke-width', 3);
      })
      .on('mouseout', (event, d) => {
        tooltip.style.display = 'none';
        d3.select(event.target)
          .attr('stroke', d.isSubcategory ? d.color : '#fff')
          .attr('stroke-width', d.isSubcategory ? 1.5 : 2);
      });

    // Search
    const searchInput = document.getElementById('graph-search');
    const searchCount = document.getElementById('search-count');

    function applySearch(query) {
      const normalized = query.trim().toLowerCase();
      if (!normalized) {
        node
          .attr('opacity', 1)
          .attr('stroke', (d) => (d.isSubcategory ? d.color : '#fff'))
          .attr('stroke-width', (d) => (d.isSubcategory ? 1.5 : 2));
        link.attr('opacity', 0.5);
        label.attr('opacity', 1);
        if (searchCount) searchCount.textContent = '';
        return;
      }

      const matchedIds = new Set(
        data.nodes
          .filter((n) =>
            String(n.label || '')
              .toLowerCase()
              .includes(normalized),
          )
          .map((n) => n.id),
      );

      node
        .attr('opacity', (d) => (matchedIds.has(d.id) ? 1 : 0.12))
        .attr('stroke', (d) => (matchedIds.has(d.id) ? '#3b82f6' : '#fff'))
        .attr('stroke-width', (d) => (matchedIds.has(d.id) ? 3 : 2));
      label.attr('opacity', (d) => (matchedIds.has(d.id) ? 1 : 0.15));
      link.attr('opacity', (d) => {
        const s = typeof d.source === 'object' ? d.source.id : d.source;
        const t = typeof d.target === 'object' ? d.target.id : d.target;
        return matchedIds.has(s) || matchedIds.has(t) ? 0.75 : 0.06;
      });

      if (searchCount) {
        searchCount.textContent =
          matchedIds.size > 0 ? `${matchedIds.size} ውጤቶች` : 'ውጤት አልተገኘም';
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', (event) =>
        applySearch(event.target.value),
      );
    }

    let ticked = 0;
    simulation.on('tick', () => {
      link
        .attr('x1', (d) => d.source.x)
        .attr('y1', (d) => d.source.y)
        .attr('x2', (d) => d.target.x)
        .attr('y2', (d) => d.target.y);
      node.attr('cx', (d) => d.x).attr('cy', (d) => d.y);
      label.attr('x', (d) => d.x).attr('y', (d) => d.y);
      ticked++;
      if (ticked === 100) zoomToFit();
    });
  }
</script>

<style>
  .graph-page {
    height: 100vh;
    display: flex;
    flex-direction: column;
  }
  .graph-header {
    padding: 1rem var(--space-page-x);
    background: #1a1a2e;
    color: white;
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .graph-header h1 {
    font-size: clamp(1.25rem, 2.4vw, 1.8rem);
    margin: 0;
    font-family: var(--font-editorial);
    line-height: var(--title-line-height);
    letter-spacing: var(--title-letter-spacing);
    font-weight: 800;
  }
  .graph-header p {
    opacity: 0.78;
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.6;
    max-width: 34rem;
    color: rgba(255, 255, 255, 0.82);
  }
  .search-box {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  #graph-search {
    padding: 0.4rem 0.8rem;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.1);
    color: white;
    font-size: 0.9rem;
    width: 200px;
    outline: none;
    transition:
      border-color 0.2s,
      background 0.2s;
  }
  #graph-search::placeholder {
    color: rgba(255, 255, 255, 0.5);
  }
  #graph-search:focus {
    border-color: #3b82f6;
    background: rgba(255, 255, 255, 0.15);
  }
  .search-count {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.8rem;
    white-space: nowrap;
  }
  #graph-container {
    flex: 1;
    background: #fafafa;
    overflow: hidden;
  }
  .tooltip {
    display: none;
    position: absolute;
    background: rgba(26, 26, 46, 0.9);
    color: white;
    padding: 0.4rem 0.8rem;
    border-radius: 6px;
    font-size: 0.85rem;
    pointer-events: none;
    z-index: 100;
  }
  @media (max-width: 768px) {
    .graph-header {
      align-items: flex-start;
      padding: 0.9rem 1rem;
    }
    .graph-header h1 {
      font-size: 1.12rem;
      line-height: 1.3;
    }
    .graph-header p {
      width: 100%;
      font-size: 0.9rem;
      order: 3;
    }
    .search-box {
      width: 100%;
      order: 4;
      margin-left: 0;
      flex-wrap: wrap;
    }
    #graph-search {
      width: 100%;
    }
  }
</style>
