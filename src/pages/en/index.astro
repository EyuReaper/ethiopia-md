---
import Layout from '../../layouts/Layout.astro';
import HeroSection from '../../components/home/HeroSection.astro';
import CoverStory from '../../components/home/CoverStory.astro';
import RandomDiscovery from '../../components/home/RandomDiscovery.astro';
import CategoriesSection from '../../components/home/CategoriesSection.astro';
import RecentUpdates from '../../components/home/RecentUpdates.astro';
import NewsletterSection from '../../components/home/NewsletterSection.astro';
import ContributeSection from '../../components/home/ContributeSection.astro';
import LanguageStatement from '../../components/home/LanguageStatement.astro';
import ReadingPath from '../../components/ReadingPath.astro';
import FeatureCards from '../../components/FeatureCards.astro';
import { fetchRecentCommits } from '../../lib/commits';
import { readdir, readFile } from 'fs/promises';
import { resolve, join, basename } from 'path';
import matter from 'gray-matter';

// Fetch recent commits
const recentCommits = await fetchRecentCommits();

// Build article list for RandomDiscovery
const categories = [
  { id: 'history', name: 'History', folder: 'History' },
  { id: 'geography', name: 'Geography', folder: 'Geography' },
  { id: 'culture', name: 'Culture', folder: 'Culture' },
  { id: 'food', name: 'Food', folder: 'Food' },
  { id: 'art', name: 'Art', folder: 'Art' },
  { id: 'music', name: 'Music', folder: 'Music' },
  { id: 'technology', name: 'Technology', folder: 'Technology' },
  { id: 'nature', name: 'Nature', folder: 'Nature' },
  { id: 'people', name: 'People', folder: 'People' },
  { id: 'society', name: 'Society', folder: 'Society' },
  { id: 'economy', name: 'Economy', folder: 'Economy' },
  { id: 'lifestyle', name: 'Lifestyle', folder: 'Lifestyle' },
];

let allArticles: { title: string; url: string; category: string }[] = [];

for (const cat of categories) {
  try {
    const folderPath = resolve(process.cwd(), 'knowledge', 'en', cat.folder);
    const files = await readdir(folderPath);
    // Keep "_{Category} Hub.md" (the only fully-rewritten, published content
    // right now) but drop other underscore-prefixed meta files like _Home.md.
    const mdFiles = files.filter(
      (f) => f.endsWith('.md') && (!f.startsWith('_') || / Hub\.md$/.test(f)),
    );

    for (const file of mdFiles) {
      try {
        const content = await readFile(join(folderPath, file), 'utf-8');
        const { data: frontmatter } = matter(content);
        if (
          frontmatter.status === 'archived' ||
          frontmatter.status === 'draft'
        ) {
          continue;
        }
        const isHub = / Hub\.md$/.test(file);
        const slug = basename(file, '.md');
        allArticles.push({
          title: frontmatter.title || slug,
          url: isHub ? `/en/${cat.id}` : `/en/${cat.id}/${slug}`,
          category: cat.name,
        });
      } catch {
        // YAML parse error in this file, skip it
      }
    }
  } catch {
    // folder doesn't exist, skip
  }
}

const randomArticlesData = JSON.stringify(allArticles);

const readingPathSteps = [
  {
    href: '/en/history',
    title: "History: Ethiopia's Ancient Heritage",
    description:
      "Ethiopia's historical journey, from ancient civilization to the modern era",
    time: '6 min',
  },
  {
    href: '/en/culture',
    title: "Culture: Ethiopia's Ethnic Diversity",
    description: 'Many ethnic groups and traditions, and how they fit together',
    time: '7 min',
  },
  {
    href: '/en/food',
    title: "Food: Ethiopia's World of Flavor",
    description: 'From traditional wat and injera to modern food culture',
    time: '5 min',
  },
  {
    href: '/en/technology',
    title: 'Technology: An Ethiopia Moving Forward',
    description: 'Digital innovation and technological growth in Ethiopia',
    time: '8 min',
  },
  {
    href: '/en/lifestyle',
    title: "Lifestyle: Ethiopians' Daily Life",
    description:
      'The rhythms of modern Ethiopian life, from city to countryside',
    time: '4 min',
  },
];

const readingPathFooterItems = [
  { icon: '⏱️', label: 'Total 30 minutes' },
  { icon: '🎯', label: '5 key domains' },
  { icon: '🌟', label: 'Complete Ethiopia overview' },
];
---

<Layout
  title="Open Knowledge Base of Ethiopia"
  description="The open-source, AI-friendly knowledge base about Ethiopia. Covering history, culture, food, music, technology and more, written by the community, for the world."
  lang="en"
>
  <HeroSection />

  <CoverStory />

  <RandomDiscovery articlesJson={randomArticlesData} />

  <FeatureCards
    lang="en"
    sectionTitle="Why Ethiopia.md?"
    cards={[
      {
        icon: '🎯',
        title: 'Curated Perspectives',
        description:
          'Carefully curated deep narratives, not encyclopedic listings',
      },
      {
        icon: '🤖',
        title: 'AI-Friendly Design',
        description:
          "Structured content that helps AI understand Ethiopia's complexity",
      },
      {
        icon: '🌍',
        title: 'Bilingual Global Vision',
        description:
          "Starting from local perspectives, telling Ethiopia's story in global languages",
      },
      {
        icon: '📚',
        title: 'Complete Multi-dimensional',
        description:
          "Covering 12+ domains, presenting Ethiopia's three-dimensional complete picture",
      },
    ]}
  />

  <ReadingPath
    lang="en"
    title="📖 Don't know where to start?"
    subtitle="Get to know Ethiopia in 30 minutes with these 5 articles"
    steps={readingPathSteps}
    footerItems={readingPathFooterItems}
    continueHref="#categories"
    continueLabel="Continue exploring more topics →"
  />

  <LanguageStatement />

  <CategoriesSection>
    <Fragment slot="prose">
      <p>
        Ethiopia has towering highlands, wide plateaus, deep valleys, and lakes.
        They range from the peaks of the Ethiopian Highlands to the Danakil
        Depression, one of the lowest and hottest places on Earth. Read about
        <a href="/en/geography" class="topic-pill">🗺️ the geography here</a>:
        the Great Rift Valley is still pulling the continent apart, and it has
        shaped this land for millions of years and given each region its own
        character.
      </p>

      <p>
        Ethiopia has a long history, from ancient civilizations and early
        statehood to trade routes, the spread of religion, the fight against
        colonization and the modern era. It has its own script and its own
        calendar. Explore
        <a href="/en/history" class="topic-pill">📜 History</a> to follow this journey
        in depth: understanding the past helps make sense of Ethiopia today.
      </p>

      <p>
        Ethiopian culture grew from many ethnic groups and languages. Each
        community has its own customs, dress, festivals, and values, and
        together they form a national identity that is both unified and diverse.
        Explore
        <a href="/en/culture" class="topic-pill">🎭 Ethiopia's culture</a> to see
        how these traditions have evolved over generations and remain part of daily
        life today.
      </p>

      <p>
        Ethiopian cuisine reflects the country's diversity, from traditional
        home cooking and time-honored recipes to the modern eateries in its
        cities.
        <a href="/en/food" class="topic-pill">🫓 Explore the food</a> to learn about
        the ingredients and techniques behind it, from family feasts to street food.
      </p>

      <p>
        From highlands to wide plains and national parks, Ethiopia has many
        ecosystems. Forests, rivers, and lakes shelter many animal and plant
        species.
        <a href="/en/nature" class="topic-pill">🌿 Ethiopia's nature</a> covers wildlife,
        conservation efforts, and the challenges climate change poses to forests and
        water systems.
      </p>

      <p>
        Ethnicity, language, faith, and custom make up Ethiopia's social fabric,
        and
        <a href="/en/people" class="topic-pill">👥 Ethiopia's people</a> tells that
        story, from farmers to city dwellers and from young innovators to keepers
        of tradition.
      </p>

      <p>
        <a href="/en/art" class="topic-pill">🎨 Ethiopia's art</a> runs from ancient
        religious paintings and sculpture to contemporary work. Traditional crafts,
        painting, and the work of contemporary artists are in constant dialogue with
        one another: how much does tradition inspire contemporary creation, and where
        is it heading?
      </p>

      <p>
        Music holds a central place in Ethiopian life, from traditional melodic
        modes onward. Read about
        <a href="/en/music" class="topic-pill">🎵 Ethiopia's music</a>.
        Different regions and ethnic groups each have their own styles, rhythms,
        and instruments, passed from generation to generation at festivals and
        in everyday life. How does music express identity, and how does it bind
        a community together?
      </p>

      <p>
        Digital transformation is reaching Ethiopia too.
        <a href="/en/technology" class="topic-pill">💻 The technology</a> sector is
        growing quickly, from startups to educational institutions. What is the younger
        generation using, whether phones, AI applications, or new inventions of their
        own, and how is Ethiopia shaping its technological future?
      </p>

      <p>
        Agriculture, industry, and services are the foundation of
        <a href="/en/economy" class="topic-pill">📊 Ethiopia's economy</a>, from
        urban markets to rural production to exports. How is Ethiopia building
        future growth through job creation and investment?
      </p>

      <p>
        <a href="/en/society" class="topic-pill">🏛️ Ethiopia's society</a> is searching
        for a balance between "tradition" and "modernity." Social change, urbanization,
        and new ways of thinking are transforming the country, which moves forward
        gradually, at its own pace, without losing its identity.
      </p>

      <p>
        Ethiopians' <a href="/en/lifestyle" class="topic-pill">🏠 daily life</a> varies
        widely between city and countryside. How do work, social life, and rest find
        their balance, and how does life unfold across a typical day? From family
        tradition to modern urban living, Ethiopians are each finding their own balance,
        and "what makes a good life" remains an open question for many.
      </p>
    </Fragment>
  </CategoriesSection>

  <RecentUpdates commits={recentCommits} />

  <NewsletterSection />

  <ContributeSection />
</Layout>

<style>
  .section-title {
    font-size: 2.5rem;
    font-weight: 800;
    text-align: center;
    color: #1a1a2e;
    margin-bottom: 1rem;
  }
</style>
