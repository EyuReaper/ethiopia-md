---
import Layout from '../../layouts/Layout.astro';
import HeroSection from '../../components/home/HeroSection.astro';
import CoverStory from '../../components/home/CoverStory.astro';
import RandomDiscovery from '../../components/home/RandomDiscovery.astro';
import CategoriesSection from '../../components/home/CategoriesSection.astro';
import RecentUpdates from '../../components/home/RecentUpdates.astro';
import NewsletterSection from '../../components/home/NewsletterSection.astro';
import ContributeSection from '../../components/home/ContributeSection.astro';
import LanguageStatement from '../../components/home/LanguageStatement.astro';
import ReadingPath from '../../components/ReadingPath.astro';
import FeatureCards from '../../components/FeatureCards.astro';
import { fetchRecentCommits } from '../../lib/commits';
import { readdir, readFile } from 'fs/promises';
import { resolve, join, basename } from 'path';
import matter from 'gray-matter';

// Fetch recent commits
const recentCommits = await fetchRecentCommits();

// Build article list for RandomDiscovery
const categories = [
  { id: 'history', name: 'History', folder: 'History' },
  { id: 'geography', name: 'Geography', folder: 'Geography' },
  { id: 'culture', name: 'Culture', folder: 'Culture' },
  { id: 'food', name: 'Food', folder: 'Food' },
  { id: 'art', name: 'Art', folder: 'Art' },
  { id: 'music', name: 'Music', folder: 'Music' },
  { id: 'technology', name: 'Technology', folder: 'Technology' },
  { id: 'nature', name: 'Nature', folder: 'Nature' },
  { id: 'people', name: 'People', folder: 'People' },
  { id: 'society', name: 'Society', folder: 'Society' },
  { id: 'economy', name: 'Economy', folder: 'Economy' },
  { id: 'lifestyle', name: 'Lifestyle', folder: 'Lifestyle' },
];

let allArticles: { title: string; url: string; category: string }[] = [];

for (const cat of categories) {
  try {
    const folderPath = resolve(process.cwd(), 'knowledge', 'en', cat.folder);
    const files = await readdir(folderPath);
    const mdFiles = files.filter(
      (f) => f.endsWith('.md') && !f.startsWith('_'),
    );

    for (const file of mdFiles) {
      try {
        const content = await readFile(join(folderPath, file), 'utf-8');
        const { data: frontmatter } = matter(content);
        const slug = basename(file, '.md');
        allArticles.push({
          title: frontmatter.title || slug,
          url: `/en/${cat.id}/${slug}`,
          category: cat.name,
        });
      } catch {
        // YAML parse error in this file, skip it
      }
    }
  } catch {
    // folder doesn't exist, skip
  }
}

const randomArticlesData = JSON.stringify(allArticles);

const readingPathSteps = [
  {
    href: '/en/history',
    title: "History: Ethiopia's Ancient Heritage",
    description:
      "Ethiopia's historical journey, from ancient civilization to the modern era",
    time: '6 min',
  },
  {
    href: '/en/culture',
    title: "Culture: Ethiopia's Ethnic Diversity",
    description:
      'A rich cultural landscape woven from many ethnic groups and traditions',
    time: '7 min',
  },
  {
    href: '/en/food',
    title: "Food: Ethiopia's World of Flavor",
    description: 'From traditional wat and injera to modern food culture',
    time: '5 min',
  },
  {
    href: '/en/technology',
    title: 'Technology: An Ethiopia Moving Forward',
    description: 'Digital innovation and technological growth in Ethiopia',
    time: '8 min',
  },
  {
    href: '/en/lifestyle',
    title: "Lifestyle: Ethiopians' Daily Life",
    description:
      'The rhythms of modern Ethiopian life, from city to countryside',
    time: '4 min',
  },
];

const readingPathFooterItems = [
  { icon: '⏱️', label: 'Total 30 minutes' },
  { icon: '🎯', label: '5 key domains' },
  { icon: '🌟', label: 'Complete Ethiopia overview' },
];
---

<Layout
  title="Open Knowledge Base of Ethiopia"
  description="The open-source, AI-friendly knowledge base about Ethiopia. Covering history, culture, food, music, technology and more — written by the community, for the world."
  lang="en"
>
  <HeroSection />

  <CoverStory />

  <RandomDiscovery articlesJson={randomArticlesData} />

  <FeatureCards
    lang="en"
    sectionTitle="Why Ethiopia.md?"
    cards={[
      {
        icon: '🎯',
        title: 'Curated Perspectives',
        description:
          'Carefully curated deep narratives, not encyclopedic listings',
      },
      {
        icon: '🤖',
        title: 'AI-Friendly Design',
        description:
          "Structured content that helps AI understand Ethiopia's complexity",
      },
      {
        icon: '🌍',
        title: 'Bilingual Global Vision',
        description:
          "Starting from local perspectives, telling Ethiopia's story in global languages",
      },
      {
        icon: '📚',
        title: 'Complete Multi-dimensional',
        description:
          "Covering 12+ domains, presenting Ethiopia's three-dimensional complete picture",
      },
    ]}
  />

  <ReadingPath
    lang="en"
    title="📖 Don't know where to start?"
    subtitle="Discover the real Ethiopia in 30 minutes with these 5 essential articles"
    steps={readingPathSteps}
    footerItems={readingPathFooterItems}
    continueHref="#categories"
    continueLabel="Continue exploring more topics →"
  />

  <LanguageStatement />

  <CategoriesSection>
    <Fragment slot="prose">
      <p>
        Ethiopia is a land of striking contrasts, shaped by towering highlands,
        wide plateaus, deep valleys, and lakes. From the peaks of the Ethiopian
        Highlands to the depths of the Danakil Depression — one of the lowest
        and hottest places on Earth —
        <a href="/en/geography" class="topic-pill">🗺️ the geography here</a> tells
        the story of the Great Rift Valley still pulling the continent apart, a geological
        drama that has shaped this land for millions of years and given each region
        its own distinct character.
      </p>

      <p>
        Ethiopia has a long history, spanning ancient civilizations and
        successive eras of change — from early statehood, trade routes, and the
        spread of religion to the fight against colonization and into the modern
        era. As a country with its own script and its own calendar, Ethiopia
        holds a distinctive place in Africa. Explore
        <a href="/en/history" class="topic-pill">📜 History</a> to trace this journey
        in depth — understanding the past helps make sense of Ethiopia today, and
        offers a clearer view of where it's heading.
      </p>

      <p>
        Ethiopian culture is a rich inheritance woven from many ethnic groups
        and languages. Each community carries its own customs, dress, festivals,
        and values, together forming a national identity that is both unified
        and diverse — always offering something new to visitors and researchers
        alike. Explore
        <a href="/en/culture" class="topic-pill">🎭 Ethiopia's culture</a> to see
        how these traditions have evolved over generations and remain very much alive
        in daily life today.
      </p>

      <p>
        Ethiopian cuisine reflects the country's diversity, spanning traditional
        home cooking and time-honored recipes as well as the modern eateries
        that have spread through its cities.
        <a href="/en/food" class="topic-pill">🍜 Explore the food</a> to learn about
        the ingredients and techniques behind it. From family feasts to street food,
        Ethiopia has much to offer anyone who loves to eat — every dish carries its
        own story.
      </p>

      <p>
        From towering highlands to wide plains and national parks, Ethiopia is
        home to a rich natural ecosystem. Forests, rivers, and lakes shelter a
        remarkable range of animal and plant life.
        <a href="/en/nature" class="topic-pill">🌿 Ethiopia's nature</a> covers wildlife,
        conservation efforts, and the challenges climate change poses to forests and
        water systems. Protecting this heritage is a responsibility owed to future
        generations.
      </p>

      <p>
        Ethnicity, language, faith, and custom together weave Ethiopia's social
        fabric — the story told by
        <a href="/en/people" class="topic-pill">👥 Ethiopia's people</a> is a broad
        one. From farmers to city dwellers, from young innovators to keepers of tradition,
        every individual's story reflects a larger picture of the country.
      </p>

      <p>
        From ancient religious paintings and sculpture to contemporary work,
        <a href="/en/art" class="topic-pill">🎨 Ethiopia's art</a> spans a wide range.
        Traditional crafts, painting, and the work of contemporary artists are in
        constant dialogue with one another — how much does tradition inspire contemporary
        creation, and where is it heading?
      </p>

      <p>
        From traditional melodic modes onward, music holds a central place in
        Ethiopian life — it's worth exploring
        <a href="/en/music" class="topic-pill">🎵 Ethiopia's music</a>.
        Different regions and ethnic groups each have their own styles, rhythms,
        and instruments. From festivals to everyday life, passed from generation
        to generation, the question remains: how does music express identity,
        and how does it bind a community together?
      </p>

      <p>
        Digital transformation is reaching Ethiopia too.
        <a href="/en/technology" class="topic-pill">💻 The technology</a> sector is
        growing quickly, from startups to educational institutions. What is the younger
        generation using — phones, AI applications, or new inventions of their own
        — and how is Ethiopia shaping its technological future?
      </p>

      <p>
        Agriculture, industry, and services form the foundation of
        <a href="/en/economy" class="topic-pill">📈 Ethiopia's economy</a>,
        spanning everything from urban markets to rural production to exports.
        Job creation, investment — how is Ethiopia building its future growth?
      </p>

      <p>
        <a href="/en/society" class="topic-pill">⚖️ Ethiopia's society</a> is searching
        for balance between "tradition" and "modernity." Social change, urbanization,
        and new waves of thinking are transforming Ethiopia — without it losing its
        identity. It moves forward gradually, at its own pace.
      </p>

      <p>
        Ethiopians' <a href="/en/lifestyle" class="topic-pill">🏠 daily life</a> varies
        widely between city and countryside. How do work, social life, and rest find
        their balance? How does life unfold across a typical day? From family tradition
        to modern urban living, Ethiopians are each finding their own balance — the
        question of "what makes a good life" remains an open one for many.
      </p>
    </Fragment>
  </CategoriesSection>

  <RecentUpdates commits={recentCommits} />

  <NewsletterSection />

  <ContributeSection />
</Layout>

<style>
  .section-title {
    font-size: 2.5rem;
    font-weight: 800;
    text-align: center;
    color: #1a1a2e;
    margin-bottom: 1rem;
  }
</style>
