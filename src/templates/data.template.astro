---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import contentStats from '../data/content-stats.json';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t('data.meta.title')} description={t('data.meta.description')}>
  <main class="data-hub">
    <!-- Hero -->
    <section class="hero">
      <h1 class="hero-title">
        <span class="hero-emoji">📊</span>
        {t('data.hero.title')}
      </h1>
      <p class="hero-subtitle">{t('data.hero.subtitle')}</p>
      <p class="hero-desc">{t('data.hero.description')}</p>
    </section>

    <!-- Ethiopia vs World Infographic Section -->
    <section class="ethiopia-vs-world-section" id="global">
      <div class="section-divider">
        <div class="divider-line"></div>
      </div>

      <div class="story-intro">
        <h2 class="section-title">{t('data.ethiopiaVsWorld.title')}</h2>
        <div class="story-text">
          <p>{t('data.ethiopiaVsWorld.story.p1')}</p>
          <p>{t('data.ethiopiaVsWorld.story.p2')}</p>
        </div>
      </div>

      <div class="comparison-cards">
        <div class="comparison-card">
          <div class="card-emoji">📏</div>
          <div class="card-number">{t('data.ethiopiaVsWorld.area.number')}</div>
          <div class="card-label">{t('data.ethiopiaVsWorld.area.label')}</div>
          <div class="card-context">
            {t('data.ethiopiaVsWorld.area.context')}
          </div>
        </div>

        <div class="comparison-card">
          <div class="card-emoji">💰</div>
          <div class="card-number">{t('data.ethiopiaVsWorld.gdp.number')}</div>
          <div class="card-label">{t('data.ethiopiaVsWorld.gdp.label')}</div>
          <div class="card-context">
            {t('data.ethiopiaVsWorld.gdp.context')}
          </div>
        </div>

        <div class="comparison-card">
          <div class="card-emoji">🏭</div>
          <div class="card-number">
            {t('data.ethiopiaVsWorld.semiconductor.number')}
          </div>
          <div class="card-label">
            {t('data.ethiopiaVsWorld.semiconductor.label')}
          </div>
          <div class="card-context">
            {t('data.ethiopiaVsWorld.semiconductor.context')}
          </div>
        </div>

        <div class="comparison-card">
          <div class="card-emoji">🗳️</div>
          <div class="card-number">
            {t('data.ethiopiaVsWorld.democracy.number')}
          </div>
          <div class="card-label">
            {t('data.ethiopiaVsWorld.democracy.label')}
          </div>
          <div class="card-context">
            {t('data.ethiopiaVsWorld.democracy.context')}
          </div>
        </div>

        <div class="comparison-card">
          <div class="card-emoji">👶</div>
          <div class="card-number">
            {t('data.ethiopiaVsWorld.birthRate.number')}
          </div>
          <div class="card-label">
            {t('data.ethiopiaVsWorld.birthRate.label')}
          </div>
          <div class="card-context">
            {t('data.ethiopiaVsWorld.birthRate.context')}
          </div>
        </div>

        <div class="comparison-card">
          <div class="card-emoji">🏪</div>
          <div class="card-number">
            {t('data.ethiopiaVsWorld.convenience.number')}
          </div>
          <div class="card-label">
            {t('data.ethiopiaVsWorld.convenience.label')}
          </div>
          <div class="card-context">
            {t('data.ethiopiaVsWorld.convenience.context')}
          </div>
        </div>

        <div class="comparison-card">
          <div class="card-emoji">🚄</div>
          <div class="card-number">{t('data.ethiopiaVsWorld.hsr.number')}</div>
          <div class="card-label">{t('data.ethiopiaVsWorld.hsr.label')}</div>
          <div class="card-context">
            {t('data.ethiopiaVsWorld.hsr.context')}
          </div>
        </div>

        <div class="comparison-card">
          <div class="card-emoji">🏥</div>
          <div class="card-number">
            {t('data.ethiopiaVsWorld.healthcare.number')}
          </div>
          <div class="card-label">
            {t('data.ethiopiaVsWorld.healthcare.label')}
          </div>
          <div class="card-context">
            {t('data.ethiopiaVsWorld.healthcare.context')}
          </div>
        </div>
      </div>
    </section>

    <!-- Ethiopia Shape Section -->
    <section class="ethiopia-shape-section" id="shape">
      <div class="section-divider">
        <div class="divider-line"></div>
      </div>

      <div class="story-intro">
        <h2 class="section-title">{t('data.ethiopiaShape.title')}</h2>
        <div class="story-text">
          <p>{t('data.ethiopiaShape.story.p1')}</p>
          <p>{t('data.ethiopiaShape.story.p2')}</p>
        </div>
      </div>

      <!-- SVG Cards -->
      <div class="svg-grid">
        <div class="svg-card">
          <div class="svg-preview">
            <img src="/assets/svg/ethiopia-icon-wiki.svg" alt="Ethiopia Icon" />
          </div>
          <div class="svg-info">
            <h3>{t('data.svg.card1.title')}</h3>
            <p class="svg-desc">{t('data.svg.card1.description')}</p>
            <p class="svg-meta">Wikimedia Commons · CC</p>
            <div class="svg-actions">
              <a
                href="/assets/svg/ethiopia-icon-wiki.svg"
                download
                class="btn btn-primary"
              >
                {t('data.svg.button.download')}
              </a>
              <button
                class="btn btn-outline"
                onclick="copySVG('ethiopia-icon-wiki.svg', this)"
              >
                {t('data.svg.button.copy')}
              </button>
            </div>
          </div>
        </div>

        <div class="svg-card">
          <div class="svg-preview">
            <img
              src="/assets/svg/ethiopia-simplemaps.svg"
              alt="Ethiopia SimpleMaps"
            />
          </div>
          <div class="svg-info">
            <h3>{t('data.svg.card2.title')}</h3>
            <p class="svg-desc">{t('data.svg.card2.description')}</p>
            <p class="svg-meta">SimpleMaps · 5 KB</p>
            <div class="svg-actions">
              <a
                href="/assets/svg/ethiopia-simplemaps.svg"
                download
                class="btn btn-primary"
              >
                {t('data.svg.button.download')}
              </a>
              <button
                class="btn btn-outline"
                onclick="copySVG('ethiopia-simplemaps.svg', this)"
              >
                {t('data.svg.button.copy')}
              </button>
            </div>
          </div>
        </div>

        <div class="svg-card">
          <div class="svg-preview">
            <img
              src="/assets/svg/ethiopia-location-map.svg"
              alt="Ethiopia Location Map"
            />
          </div>
          <div class="svg-info">
            <h3>{t('data.svg.card3.title')}</h3>
            <p class="svg-desc">{t('data.svg.card3.description')}</p>
            <p class="svg-meta">Wikimedia Commons · CC</p>
            <div class="svg-actions">
              <a
                href="/assets/svg/ethiopia-location-map.svg"
                download
                class="btn btn-primary"
              >
                {t('data.svg.button.download')}
              </a>
              <button
                class="btn btn-outline"
                onclick="copySVG('ethiopia-location-map.svg', this)"
              >
                {t('data.svg.button.copy')}
              </button>
            </div>
          </div>
        </div>

        <div class="svg-card">
          <div class="svg-preview">
            <img
              src="/assets/svg/ethiopia-political-division.svg"
              alt="Ethiopia Political Division"
            />
          </div>
          <div class="svg-info">
            <h3>{t('data.svg.card4.title')}</h3>
            <p class="svg-desc">{t('data.svg.card4.description')}</p>
            <p class="svg-meta">Wikimedia Commons · CC</p>
            <div class="svg-actions">
              <a
                href="/assets/svg/ethiopia-political-division.svg"
                download
                class="btn btn-primary"
              >
                {t('data.svg.button.download')}
              </a>
              <button
                class="btn btn-outline"
                onclick="copySVG('ethiopia-political-division.svg', this)"
              >
                {t('data.svg.button.copy')}
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Usage Example -->
      <div class="usage-example">
        <h3>{t('data.svg.usage.heading')}</h3>
        <div class="code-block">
          <pre><code>&lt;!-- በቀጥታ አካትት / Embed directly --&gt;
&lt;img src="https://ethiopia.md/assets/svg/ethiopia-icon-wiki.svg" alt="Ethiopia" width="200"&gt;

&lt;!-- እንደ CSS ዳራ / As CSS background --&gt;
background-image: url('https://ethiopia.md/assets/svg/ethiopia-icon-wiki.svg');

&lt;!-- በMarkdown ውስጥ / In Markdown --&gt;
![Ethiopia](https://ethiopia.md/assets/svg/ethiopia-icon-wiki.svg)</code></pre>
        </div>
        <p class="license-note">
          {t('data.svg.usage.licenseNote')}
        </p>
      </div>
    </section>

    <!-- Footer -->
    <footer class="data-footer">
      <div class="section-divider">
        <div class="divider-line"></div>
      </div>

      <h3 class="footer-title">{t('data.footer.heading')}</h3>
      <div class="footer-links">
        <a href="/economy" class="footer-link">
          <span class="footer-icon">📈</span>
          <div class="footer-text">
            <span class="footer-name">{t('data.footer.link1.name')}</span>
            <span class="footer-desc">
              {t('data.footer.link1.description')}
            </span>
          </div>
        </a>
        <a href="/graph" class="footer-link">
          <span class="footer-icon">🕸️</span>
          <div class="footer-text">
            <span class="footer-name">{t('data.footer.link2.name')}</span>
            <span class="footer-desc">
              {t('data.footer.link2.description')}
            </span>
          </div>
        </a>
        <a href="/contribute" class="footer-link">
          <span class="footer-icon">✋</span>
          <div class="footer-text">
            <span class="footer-name">{t('data.footer.link3.name')}</span>
            <span class="footer-desc">
              {t('data.footer.link3.description')}
            </span>
          </div>
        </a>
      </div>
    </footer>
  </main>

  <!-- SVG Copy Function -->
  <script is:inline define:vars={{ lang }}>
    async function copySVG(filename, btn) {
      const currentLang = lang;
      try {
        const res = await fetch('/assets/svg/' + filename);
        const text = await res.text();
        await navigator.clipboard.writeText(text);
        const orig = btn.textContent;
        btn.textContent = currentLang === 'am' ? '✅ ተቀድቷል' : '✅ Copied';
        setTimeout(() => (btn.textContent = orig), 2000);
      } catch (e) {
        btn.textContent = currentLang === 'am' ? '❌ አልተሳካም' : '❌ Failed';
        setTimeout(
          () =>
            (btn.textContent = currentLang === 'am' ? 'SVG ቅዳ' : 'Copy SVG'),
          2000,
        );
      }
    }
  </script>

  <!-- Chart.js Visualization Script -->
  <script define:vars={{ contentStats, lang }}>
    // Load Chart.js
    const chartScript = document.createElement('script');
    chartScript.src =
      'https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js';
    chartScript.onload = () => initContentCharts();
    document.head.appendChild(chartScript);

    function initContentCharts() {
      const isEn = lang === 'en';
      const stats = contentStats;

      // Category Distribution Chart (Doughnut)
      const categoryCtx = document.getElementById('categoryChart');
      if (categoryCtx) {
        const categoryData = Object.entries(stats.categories)
          .filter(([cat]) => cat !== 'root')
          .sort((a, b) => b[1] - a[1]);

        new Chart(categoryCtx, {
          type: 'doughnut',
          data: {
            labels: categoryData.map(([cat]) => cat),
            datasets: [
              {
                data: categoryData.map(([, count]) => count),
                backgroundColor: [
                  '#3b82f6',
                  '#8b5cf6',
                  '#ec4899',
                  '#f59e0b',
                  '#10b981',
                  '#06b6d4',
                  '#84cc16',
                  '#f97316',
                  '#ef4444',
                  '#6366f1',
                  '#8b5cf6',
                  '#ec4899',
                  '#f59e0b',
                  '#10b981',
                  '#06b6d4',
                ],
                borderWidth: 2,
                borderColor: '#1e293b',
                hoverBorderWidth: 3,
              },
            ],
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: {
                position: 'bottom',
                labels: {
                  color: '#e2e8f0',
                  font: { size: 11 },
                  padding: 12,
                  usePointStyle: true,
                },
              },
              tooltip: {
                backgroundColor: 'rgba(0, 0, 0, 0.8)',
                titleColor: '#e2e8f0',
                bodyColor: '#e2e8f0',
                borderColor: 'rgba(255, 255, 255, 0.1)',
                borderWidth: 1,
                callbacks: {
                  label: function (context) {
                    const total = context.dataset.data.reduce(
                      (a, b) => a + b,
                      0,
                    );
                    const percentage = ((context.raw / total) * 100).toFixed(1);
                    return `${context.label}: ${context.raw} ጽሑፎች (${percentage}%)`;
                  },
                },
              },
            },
          },
        });
      }

      // Growth Timeline Chart (Line)
      const growthCtx = document.getElementById('growthChart');
      if (growthCtx) {
        const growthData = stats.dailyGrowth || [];

        new Chart(growthCtx, {
          type: 'line',
          data: {
            labels: growthData.map((d) => d.date),
            datasets: [
              {
                label: isEn ? 'Articles Added' : 'የተጨመሩ ጽሑፎች',
                data: growthData.map((d) => d.count),
                borderColor: '#3b82f6',
                backgroundColor: 'rgba(59, 130, 246, 0.1)',
                borderWidth: 3,
                fill: true,
                tension: 0.4,
                pointBackgroundColor: '#3b82f6',
                pointBorderColor: '#1e293b',
                pointBorderWidth: 2,
                pointRadius: 5,
                pointHoverRadius: 7,
              },
            ],
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
              x: {
                ticks: {
                  color: '#94a3b8',
                  font: { size: 11 },
                },
                grid: {
                  color: 'rgba(148, 163, 184, 0.1)',
                },
              },
              y: {
                beginAtZero: true,
                ticks: {
                  color: '#94a3b8',
                  font: { size: 11 },
                },
                grid: {
                  color: 'rgba(148, 163, 184, 0.1)',
                },
              },
            },
            plugins: {
              legend: {
                display: false,
              },
              tooltip: {
                backgroundColor: 'rgba(0, 0, 0, 0.8)',
                titleColor: '#e2e8f0',
                bodyColor: '#e2e8f0',
                borderColor: 'rgba(255, 255, 255, 0.1)',
                borderWidth: 1,
              },
            },
            elements: {
              point: {
                hoverBackgroundColor: '#60a5fa',
              },
            },
          },
        });
      }
    }
  </script>

  <style>
    .data-hub {
      min-height: 100vh;
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
      color: #e2e8f0;
    }

    /* Hero */
    .hero {
      text-align: center;
      padding: 4rem 2rem 3rem;
      max-width: 1400px;
      margin: 0 auto;
    }

    .hero-title {
      font-family: var(--font-title, 'Noto Serif TC', serif);
      font-size: clamp(2.5rem, 6vw, 3.5rem);
      font-weight: 900;
      background: linear-gradient(135deg, #38bdf8, #818cf8, #c084fc);
      background-clip: text;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-bottom: 1rem;
      letter-spacing: -0.02em;
    }

    .hero-emoji {
      -webkit-text-fill-color: initial;
      background: none;
      -webkit-background-clip: initial;
      background-clip: initial;
    }

    .hero-subtitle {
      font-size: 1.3rem;
      color: #94a3b8;
      margin-bottom: 1.5rem;
      font-weight: 500;
      max-width: 600px;
      margin-left: auto;
      margin-right: auto;
      line-height: 1.7;
    }

    .hero-desc {
      font-size: 1rem;
      line-height: 1.7;
      color: #cbd5e1;
      max-width: 600px;
      margin: 0 auto;
    }

    /* Section Divider */
    .section-divider {
      padding: 2rem 0;
      display: flex;
      justify-content: center;
    }

    .divider-line {
      width: 100px;
      height: 3px;
      background: linear-gradient(90deg, transparent, #60a5fa, transparent);
      border-radius: 2px;
    }

    /* Story Block */
    .story-intro {
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 2rem 2rem;
    }

    .section-title {
      font-size: 2rem;
      font-weight: 800;
      color: #f8fafc;
      margin-bottom: 1rem;
      text-align: center;
    }

    .story-text {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 16px;
      padding: 2rem;
    }

    .story-text p {
      color: #cbd5e1;
      line-height: 1.8;
      margin-bottom: 1rem;
      font-size: 1rem;
    }

    .story-text p:first-child {
      font-size: 1.1rem;
      color: #93c5fd;
      font-weight: 600;
    }

    .story-text p:last-child {
      margin-bottom: 0;
    }

    /* Ethiopia Shape Section */
    .ethiopia-shape-section {
      padding: 2rem 0 4rem;
    }

    .svg-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.5rem;
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    .svg-card {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 16px;
      overflow: hidden;
      transition: all 0.3s;
    }

    .svg-card:hover {
      border-color: rgba(255, 255, 255, 0.2);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    }

    .svg-preview {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem;
      background: rgba(255, 255, 255, 0.95);
      height: 140px;
    }

    .svg-preview img {
      max-height: 100px;
      max-width: 80px;
      filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.1));
    }

    .svg-info {
      padding: 1.5rem;
    }

    .svg-info h3 {
      font-family: 'Courier New', monospace;
      font-size: 0.9rem;
      color: #e2e8f0;
      margin-bottom: 0.5rem;
    }

    .svg-desc {
      color: #cbd5e1;
      margin-bottom: 0.25rem;
      font-size: 0.9rem;
    }

    .svg-meta {
      color: #94a3b8;
      font-size: 0.8rem;
      margin-bottom: 1rem;
    }

    .svg-actions {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-block;
      padding: 0.4rem 1rem;
      border-radius: 8px;
      font-size: 0.85rem;
      text-decoration: none;
      cursor: pointer;
      border: none;
      font-family: inherit;
      transition: all 0.2s;
      font-weight: 600;
    }

    .btn-primary {
      background: #3b82f6;
      color: #fff;
    }

    .btn-primary:hover {
      background: #2563eb;
    }

    .btn-outline {
      background: transparent;
      color: #60a5fa;
      border: 1px solid #60a5fa;
    }

    .btn-outline:hover {
      background: rgba(96, 165, 250, 0.1);
    }

    .usage-example {
      max-width: 1400px;
      margin: 3rem auto 0;
      padding: 0 2rem;
    }

    .usage-example h3 {
      color: #f8fafc;
      margin-bottom: 1rem;
      font-size: 1.2rem;
    }

    .code-block {
      background: #1e293b;
      border-radius: 12px;
      padding: 1.5rem;
      overflow-x: auto;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .code-block code {
      color: #e2e8f0;
      font-size: 0.85rem;
      line-height: 1.6;
      white-space: pre;
    }

    .license-note {
      margin-top: 1rem;
      color: #94a3b8;
      font-size: 0.9rem;
    }

    .license-note a {
      color: #60a5fa;
      text-decoration: none;
    }

    .license-note a:hover {
      text-decoration: underline;
    }

    /* Ethiopia vs World Section */
    .ethiopia-vs-world-section {
      padding: 2rem 0 4rem;
    }

    .comparison-cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.5rem;
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    .comparison-card {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 16px;
      padding: 2rem;
      text-align: center;
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
    }

    .comparison-card:hover {
      transform: translateY(-4px);
      border-color: rgba(255, 255, 255, 0.15);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
    }

    .comparison-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, #3b82f6, #8b5cf6, #ec4899);
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .comparison-card:hover::before {
      opacity: 1;
    }

    .card-emoji {
      font-size: 2.5rem;
      margin-bottom: 1rem;
      display: block;
    }

    .card-number {
      font-size: 2.2rem;
      font-weight: 900;
      color: #60a5fa;
      margin-bottom: 0.5rem;
      line-height: 1;
    }

    .card-label {
      font-size: 1.1rem;
      font-weight: 600;
      color: #e2e8f0;
      margin-bottom: 0.75rem;
      line-height: 1.3;
    }

